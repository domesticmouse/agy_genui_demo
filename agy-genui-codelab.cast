[0.000, "o", "ers/brett/tmp/agy_genui_demo/lib/ui/features/chat/view_models/chat_view_model.dart#L256\u0007_flushPendingAutoForwardRpcMessages\u001b[m\u001b]8;;\u0007, and \u001b[34;4m\u001b]8;id=jke39dd0a795bb9621;file:///Users/brett/tmp/agy_genui_demo/lib/ui/features/chat/view_models/chat_view_model.dart#L773\u0007sendRpcMessagesToAgent\u001b[m\u001b]8;;\u0007.\r\n\u001b[6C• Outbound RPC messages emitted while an assistant reply is still streaming are queued and flushed in a single\r\n\u001b[6Cbatched \u001b[94mRendererToAgentMessagePayload\u001b[m turn when the stream completes (\u001b[94monDone\u001b[m), preventing mid-stream\r\n\u001b[6Ccancellation and multi-RPC race conditions.\r\n  3. \u001b[1mPreserved Custom Thread Titles on First Message (\u001b[34;4m\u001b]8;id=jkbc9189ff80391e6f;file:///Users/brett/tmp/agy_genui_demo/lib/ui/features/chat/view_models/chat_view_model.dart#L691\u0007c\u001b[22mhat_view_model.dart:691\u001b[39;24;1m\u001b]8;;\u0007)\u001b[m:\n\u001b[74D• Updated [\u001b[94mChatViewModel.\u001b[m\n\u001b[25D\u001b[94msendMessage\u001b[m](file:///Users/brett/tmp/agy_genui_demo/lib/ui/features/chat/view_models/chat_vi\r\n\n⡿  \u001b[90mLoading..\u001b[94m.\u001b[m\r\n\u001b[90m└ Tip:"]
