[0.000, "o", "(\u001b[34;4m\u001b]8;id=jkff564a184dd01237;file:///Users/brett/tmp/agy_genui_demo/lib/ui/features/chat/view_models/chat_view_model.dart\u0007chat_view_model.dart\u001b[m\u001b]8;;\u0007 + modular widgets).\u001b[K\r\n  • \u001b[1mTestability\u001b[m: \u001b[34;4m\u001b]8;id=jkf7bca013c2daff42;file:///Users/brett/tmp/agy_genui_demo/lib/data/repositories/chat_repository.dart#L15-L24\u0007AntigravityAgentSession\u001b[m\u001b]8;;\u0007 and \u001b[34;4m\u001b]8;id=jk4c64affd4f891c2e;file:///Users/brett/tmp/agy_genui_demo/lib/data/repositories/chat_repository.dart#L69-L73\u0007AntigravitySessionBuilder\u001b[m\u001b]8;;\u0007 cleanly decouple the UI/ViewModel from the\r\n  external \u001b[94mlocalharness\u001b[m process, enabling fast, deterministic streaming and RPC tests.\u001b[K\r\n  • \u001b[1mDesktop UX Polish\u001b[m: Proper IME composition guarding in \u001b[34;4m\u001b]8;id=jkea33580e32de966f;file:///Users/brett/tmp/agy_genui_demo/lib/ui/features/chat/views/widgets/markdown_composer.dart#L74-L77\u0007MarkdownComposer._isImeComposing\u001b[m\u001b]8;;\u0007, per-thread draft\r\n  preservation, and macOS \u001b[94m.app\u001b[m bundle working directory fallback in \u001b[34;4m\u001b]8;id="]
[0.000, "o", "jkae94b84ba8300232;file:///Users/brett/tmp/agy_genui_demo/lib/data/repositories/chat_repository.dart#L227-L237\u0007ChatRepository.resolveDefaultWorkingDirectory\u001b[m\u001b]8;;\u0007.\r\n  ──────\u001b[K\r\n  \u001b[1m## 2. Bugs & Functional Issues\u001b[m\r\n\u001b[K\n  \u001b[1m### 2.1. A2UI Surface Actions & Outbound RPC Messages Are Not Forwarded in the Live App\u001b[m\r\n\u001b[K\n  In \u001b[34;4m\u001b]8;id=jk826b19325cfce503;file:///Users/brett/tmp/agy_genui_demo/lib/ui/features/chat/view_models/chat_view_model.dart#L20-L28\u0007ChatViewModel\u001b[m\u001b]8;;\u0007, both \u001b[94mforwardSurfaceActionsToAgent\u001b[m and \u001b[94mforwardRpcMessagesToAgent\u001b[m default to \u001b[94mfalse\u001b[m:\r\n\u001b[K\n\u001b[4C\u001b[38;5;70;1mthis\u001b[38;5;252;22m.forwardSurfaceActionsToAgent = \u001b[38;5;70;1mfalse\u001b[38;5;252;22m,\u001b[m\r\n\t\t\u001b[38;5;252mRpcMessages\u001b[m\u001b[3P\r\n\u001b[K\n  Because \u001b[34;4m\u001b]8;id=jke85d7755023aa69d;file:///Users/brett/tmp/agy_genui_demo/lib/main.dart#L22\u0007MarkdownChatApp\u001b[m\u001b]8;;\u0007 instantiates \u001b[94mChatViewModel()\u001b[m with default parameters, clicking interactive submit buttons\r\n  on \u001b[94mA2uiSurface\u001b[m cards or executing ag"]
