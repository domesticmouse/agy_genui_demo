[0.000, "o", "m\u001b[4;34;4me\u001b[m\u001b[4;34;4ms\u001b[m\u001b[4;34;4m,\u001b[m\u001b[34;4m \u001b[m\u001b[4;34;4md\u001b[m\u001b[4;34;4me\u001b[m\u001b[4;34;4mf\u001b[m\u001b[4;34;4ma\u001b[m\u001b[4;34;4mu\u001b[m\u001b[4;34;4ml\u001b[m\u001b[4;34;4mt\u001b[m\u001b[4;34;4mT\u001b[m\u001b[4;34;4mo\u001b[m\u001b[4;34;4mC\u001b[m\u001b[4;34;4mw\u001b[m\u001b[4;34;4md\u001b[m\u001b[4;34;4m:\u001b[m\u001b[34;4m \u001b[m\u001b[4;34;4mt\u001b[m\u001b[4;34;4mr\u001b[m\u001b[4;34;4mu\u001b[m\u001b[4;34;4me\u001b[m\u001b[4;34;4m)\u001b[m\u001b]8;;\u001b\\.\u001b[K\r\n\u001b[?5W\u001b[J\u001b[6C• When \u001b[94mworkspaces\u001b[m is \u001b[94mnull\u001b[m, \u001b[94mnormalizeWorkspacePaths\u001b[m returns \u001b[94m[Directory.current.absolute.path]\u001b[m.\n\u001b[93D• \u001b[34;4m\u001b]8;id=jk983be6db0da6894a;file:///Users/brett/.pub-cache/hosted/pub.dev/antigravity-0.18.1/lib/src/connections/local/local_connection.dart#L437-L443\u0007LocalConnectionStrategy._buildHarnessConfig\u001b[m\u001b]8;;\u0007 sends this to \u001b[94mlocalharness\u001b[m over the WebSocket initialization\r\n\u001b[6Chandshake as:\r\n\t\u001b[38;5;214m\"workspaces\"\u001b[38;5;124;48;5;188m:\u001b[38;5;252;49m [\u001b[m\r\n\t\u001b[38;5;252m  { \u001b[38;5;70;1m\"filesystem_workspace\"\u001b[38;5;252;22m: { \u001b[38;5;70;1m\"directory\"\u001b[38;5;252;22m: \u001b[38;5;214m\"<Directory.current.absolute.path>\"\u001b[38;5;252m } }\u001b[m\r\n\t\u001b[38;5;252m]\u001b[m\r\n\n  3. \u001b[1mS"]
[0.000, "o", "ubprocess Spawning (\u001b[94;22mProcess.start\u001b[39;1m)\u001b[m\n\u001b[34D• \u001b[34;4m\u001b]8;id=jkfe279761137e715;file:///Users/brett/.pub-cache/hosted/pub.dev/antigravity-0.18.1/lib/src/connections/local/local_connection.dart#L152\u0007LocalConnectionStrategy.start\u001b[m\u001b]8;;\u0007 spawns the binary via \u001b[94mProcess.start(resolvedBinaryPath, [])\u001b[m without a\r\n\u001b[6C\u001b[94mworkingDirectory\u001b[m parameter, so the \u001b[94mlocalharness\u001b[m child process also inherits \u001b[94mDirectory.current\u001b[m from the Flutter\r\n\u001b[6Capp.\r\n\n\n  \u001b[1m#### What directory that resolves to in practice on macOS:\u001b[m\r\n\n  • \u001b[1mLaunched via CLI (\u001b[94;22mflutter run -d macos\u001b[39;1m)\u001b[m: \u001b[94mDirectory.current.absolute.path\u001b[m is the shell directory where \u001b[94mflutter run\u001b[m\r\n  was invoked (e.g., \u001b[94m/Users/brett/tmp/agy_genui_demo\u001b[m).\r\n  • \u001b[1mLaunched from Finder / Dock / \u001b[94;22mopen\u001b[39;1m (\u001b[94;22magy_genui_demo.app\u001b[39;1m)\u001b[m: macOS \u001b[94mlaunchd\u001b[m sets the process working directory of GUI\r\n  app bundles to \u001b[94m/\u001b[m (the root directory), unless changed or overridden.\r\n  "]
