[0.000, "o", "e:///Users/brett/tmp/agy_genui_demo/lib/ui/features/chat/views/widgets/markdown_composer.dart#L74-L77\u0007MarkdownComposer._isImeComposing\u001b[m\u001b]8;;\u0007, per-thread draft\r\n  preservation, and macOS \u001b[94m.app\u001b[m bundle working directory fallback in \u001b[34;4m\u001b]8;id=jke3d879aa98f42a78;file:///Users/brett/tmp/agy_genui_demo/lib/data/repositories/chat_repository.dart#L227-L237\u0007ChatRepository.resolveDefaultWorkingDirectory\u001b[m\u001b]8;;\u0007.\r\n  ──────\r\n  \u001b[1m## 2. Bugs & Functional Issues\u001b[m\r\n\n  \u001b[1m### 2.1. A2UI Surface Actions & Outbound RPC Messages Are Not Forwarded in the Live App\u001b[m\r\n\n  In \u001b[34;4m\u001b]8;id=jke0662b97c61e0f81;file:///Users/brett/tmp/agy_genui_demo/lib/ui/features/chat/view_models/chat_view_model.dart#L20-L28\u0007ChatViewModel\u001b[m\u001b]8;;\u0007, both \u001b[94mforwardSurfaceActionsToAgent\u001b[m and \u001b[94mforwardRpcMessagesToAgent\u001b[m default to \u001b[94mfalse\u001b[m:\n\n\u001b[97D\u001b[38;5;70;1mthis\u001b[38;5;252;22m.forwardSurfaceActionsToAgent = \u001b[38;5;70;1mfalse\u001b[38;5;252;22m,\u001b[m\n\u001b[42D\u001b[38;5;70;1mthis\u001b[38;5;252;22m.forwardRpcMessagesToAgent = \u001b[3"]
[0.000, "o", "8;5;70;1mfalse\u001b[38;5;252;22m,\u001b[m\r\n\n  Because \u001b[34;4m\u001b]8;id=jk5963e0bad2b9537b;file:///Users/brett/tmp/agy_genui_demo/lib/main.dart#L22\u0007MarkdownChatApp\u001b[m\u001b]8;;\u0007 instantiates \u001b[94mChatViewModel()\u001b[m with default parameters, clicking interactive submit buttons\r\n  on \u001b[94mA2uiSurface\u001b[m cards or executing agent-initiated \u001b[94mcallRendererFunction\u001b[m calls in the live desktop app only appends\r\n  to \u001b[94m_threadActions\u001b[m / \u001b[94m_threadOutboundRpcMessages\u001b[m without sending the response turn back to the Antigravity agent\r\n  (tests call \u001b[34;4m\u001b]8;id=jkc8cc0ec0044f89fb;file:///Users/brett/tmp/agy_genui_demo/lib/ui/features/chat/view_models/chat_view_model.dart#L687\u0007sendSurfaceAction\u001b[m\u001b]8;;\u0007 and \u001b[34;4m\u001b]8;id=jkcc6e6b6c1c51d6f;file:///Users/brett/tmp/agy_genui_demo/lib/ui/features/chat/view_models/chat_view_model.dart#L730\u0007sendRpcMessageToAgent\u001b[m\u001b]8;;\u0007 manually).\r\n\n  \u001b[1m### 2.2. Stream Self-Cancellation When Handling Outbound RPC Calls\u001b[m\r\n\n  When \u001b[94mforwardRpcMessagesToAgent\u001b[m is enabled (or when multiple RPC "]
[0.001, "o", "responses are sent), \u001b[34;4m\u001b]8;id=jkf5d4289452d91dc6;file:///Users/brett/tmp/agy_genui_demo/lib/ui/features/chat/view_models/chat_view_model.dart#L217-L230\u0007_handleOutboundRpcMessage\u001b[m\u001b]8;;\u0007\r\n  synchronously invokes \u001b[34;4m\u001b]8;id=jk25e0dce497f29a0d;file:///Users/brett/tmp/agy_genui_demo/lib/ui/features/chat/view_models/chat_view_model.dart#L730-L766\u0007sendRpcMessageToAgent\u001b[m\u001b]8;;\u0007 → \u001b[34;4m\u001b]8;id=jk38544b00cfbfc22d;file:///Users/brett/tmp/agy_genui_demo/lib/ui/features/chat/view_models/chat_view_model.dart#L788-L795\u0007_streamAssistantTurn\u001b[m\u001b]8;;\u0007, which immediately cancels\r\n  \u001b[94m_replySubscriptions[threadId]\u001b[m:\r\n\n  1. \u001b[1mMid-stream cancellation\u001b[m: \u001b[94mStreamedAnswer.feed(chunk)\u001b[m processes \u001b[94m<a2ui-json>\u001b[m blocks while the assistant's stream is\r\n  still\r\n⢿  \u001b[94mLoadi\u001b[90mng...\u001b[m\r\n\u001b[90m───────────────────────────────────────────────────────────────────────"]
