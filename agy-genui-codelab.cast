[0.017, "o", "\u001b[?2026h\u001b[29A\u001b[1m### Summary of Fixes\u001b[m\r\n\u001b[K\n  1. \u001b[1mEnabled Automatic A2UI Surface Action & Outbound RPC Forwarding in Production (\u001b[34;4m\u001b]8;id=jk350abd82a713a824;file:///Users/brett/tmp/agy_genui_demo/lib/main.dart#L21-L27\u0007m\u001b[22main.dart:21-27\u001b[39;24;1m\u001b]8;;\u0007)\u001b[m:\r\n      • Configured the default \u001b[34;4m\u001b]8;id=jk36a001c79b416d56;file:///Users/brett/tmp/agy_genui_demo/lib/ui/features/chat/view_models/chat_view_model.dart#L20\u0007ChatViewModel\u001b[m\u001b]8;;\u0007 in \u001b[34;4m\u001b]8;id=jk8f3219ca623a5806;file:///Users/brett/tmp/agy_genui_demo/lib/main.dart#L12\u0007MarkdownChatApp\u001b[m\u001b]8;;\u0007 with \u001b[94mforwardSurfaceActionsToAgent: true\u001b[m and\r\n\u001b[6C\u001b[94mforwardRpcMessagesToAgent: true\u001b[m so user surface interactions and renderer RPC responses are automatically sent\r\n\u001b[6Cto the Antigravity agent.\u001b[K\r\n  2. \u001b[1mBatched, Stream-Safe Outbound RPC Forwarding (\u001b[34;4m\u001b]8;id=jke3a7385f9b614817;file:///Users/brett/tmp/agy_genui_demo/lib/ui/features/chat/view_models/chat_view_model.dart#L220-L253\u0007c\u001b[22mhat_view_model.dart:220-253\u001b[39;24;1m\u001b]8;"]
[0.000, "o", ";\u0007)\u001b[m:\r\n      • Added \u001b[34;4m\u001b]8;id=jk6da54244f62e86bb;file:///Users/brett/tmp/agy_genui_demo/lib/ui/features/chat/view_models/chat_view_model.dart#L235\u0007_enqueueOutboundRpcForForwarding\u001b[m\u001b]8;;\u0007, \u001b[34;4m\u001b]8;id=jk8a043056b071fc45;file:///Users/brett/tmp/agy_genui_demo/lib/ui/features/chat/view_models/chat_view_model.dart#L256\u0007_flushPendingAutoForwardRpcMessages\u001b[m\u001b]8;;\u0007, and \u001b[34;4m\u001b]8;id=jk81c9fed16e59e1ac;file:///Users/brett/tmp/agy_genui_demo/lib/ui/features/chat/view_models/chat_view_model.dart#L773\u0007sendRpcMessagesToAgent\u001b[m\u001b]8;;\u0007.\r\n\tOutbound RPC messages emitted while an assistant reply is still streaming are queued and flushed in a single\r\n\u001b[6Cbatched \u001b[94mRendererToAgentMessagePayload\u001b[m turn when the stream completes (\u001b[94monDone\u001b[m), preventing mid-stream\u001b[K\r\n\u001b[6Ccancellation and multi-RPC race conditions.\u001b[K\r\n  3. \u001b[1mPreserved Custom Thread Titles on First Message (\u001b[34;4m\u001b]8;id=jk684f059cb3b2b092;file:///Users/brett/tmp/agy_genui_demo/lib/ui/features/chat/view_models/chat_view_model.dart#L691\u0007c\u001b"]
[0.000, "o", "[22mhat_view_model.dart:691\u001b[39;24;1m\u001b]8;;\u0007)\u001b[m:\r\n      • Updated \u001b[34;4m\u001b]8;id=jk658e84c64f1f7e38;file:///Users/brett/tmp/agy_genui_demo/lib/ui/features/chat/view_models/chat_view_model.dart#L667\u0007ChatViewModel.sendMessage\u001b[m\u001b]8;;\u0007 to check \u001b[94m!current.isAutoTitled\u001b[m so explicitly renamed empty threads keep\r\n\u001b[6Ctheir custom title when the first message is sent.\u001b[K\r\n  4. \u001b[1mHardened Sandbox-Escape Path Heuristics (\u001b[34;4m\u001b]8;id=jkb46075a2caba0ffd;file:///Users/brett/tmp/agy_genui_demo/lib/data/repositories/chat_repository.dart#L315-L398\u0007c\u001b[22mhat_repository.dart:315-398\u001b[39;24;1m\u001b]8;;\u0007)\u001b[m:\r\n      • Updated \u001b[34;4m\u001b]8;id=jk10998f3f97f23081;file:///Users/brett/tmp/agy_genui_demo/lib/data/repositories/chat_repository.dart#L315\u0007ChatRepository.findOutsideWorkspacePathInCommand\u001b[m\u001b]8;;\u0007 to inspect \u001b[94m--flag=/path\u001b[m and \u001b[94mKEY=/path\u001b[m assignments,\r\n\u001b[6Cexpand \u001b[94m$HOME\u001b[m/\u001b[94m${HOME}\u001b[m and \u001b[94m$TMPDIR\u001b[m/\u001b[94m${TMPDIR}\u001b[m prefixes, catch trailing \u001b[94m/..\u001b[m segments, and ignore single-seg\tt\u001b[K\r\n\u001b"]
[0.000, "o", "[6C\u001b[94m/regex/\u001b[m literals (e.g., \u001b[94mawk '/pattern/'\u001b[m).\u001b[K\r\n  5. \u001b[1mBounded Synchronous Directory Scans & Widget Cleanup\u001b[m:\r\n      • Added cancellation checking and a scan limit (\u001b[94mmaxScannedEntries = 1000\u001b[m) to \u001b[34;4m\u001b]8;id=jk93aca413398375fd;file:///Users/brett/tmp/agy_genui_demo/lib/data/catalog/renderer_rpc_functions.dart#L179-L199\u0007ListWorkspaceFilesFunction.execute\u001b[m\u001b]8;;\u0007.\r\n\tReset the \u001b[94m_copied\u001b[m state in \u001b[34;4m\u001b]8;id=jk8740a6c6c16c637;file:///Users/brett/tmp/agy_genui_demo/lib/ui/features/chat/views/widgets/message_bubble.dart#L40-L44\u0007MessageBubble.didUpdateWidget\u001b[m\u001b]8;;\u0007 when the message ID changes.\u001b[K\r\n\tRemoved the unused \u001b[94mcupertino_icons\u001b[m dependency in \u001b[34;4m\u001b]8;id=jk2d6ffa78b77b9fd2;file:///Users/brett/tmp/agy_genui_demo/pubspec.yaml#L30-L35\u0007pubspec.yaml:30-35\u001b[m\u001b]8;;\u0007 and fixed section numbering in\r\n\u001b[6C\u001b[34;4m\u001b]8;id=jk649bdfc429d4376;file:///Users/brett/tmp/agy_genui_demo/README.md#L19-L51\u0007README.md:19-51\u001b[m\u001b]8;;\u0007.\u001b[K\n\u001b[16D• Added regression tests in [widget_test.dar"]
[0.000, "o", "t](file:///Users/brett/tmp/agy_genui_demo/test/widget_test.\r\n\u001b[6Cdart#L1367-L1485\u001b[K\n\n\n\n\n\u001b[20D\u001b[?2026l"]
