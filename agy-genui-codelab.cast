[0.000, "o", "\u001b[K\r\n  • \u001b[1mCatalog Specification\u001b[m: \u001b[34;4m\u001b]8;id=jk980deefd34078080;file:///Users/brett/.pub-cache/hosted/pub.dev/a2ui_core-0.5.0/lib/src/core/catalog.dart\u0007Catalog<T extends ComponentApi, F extends FunctionApi>\u001b[m\u001b]8;;\u0007 and \u001b[34;4m\u001b]8;id=jk4419fb138194eceb;file:///Users/brett/.pub-cache/hosted/pub.dev/a2ui_core-0.5.0/lib/src/basic_catalog/basic_catalog.dart\u0007BasicCatalog.v1_0\u001b[m\u001b]8;;\u0007 (JSON Schemas\r\n  for components and executable client-side functions like \u001b[94mformatString\u001b[m, \u001b[94mrequired\u001b[m, \u001b[94mregex\u001b[m).\u001b[K\r\n  • \u001b[1mMessage Routing & Validation\u001b[m: \u001b[34;4m\u001b]8;id=jk423267f86fde37f9;file:///Users/brett/.pub-cache/hosted/pub.dev/a2ui_core-0.5.0/lib/src/processing/processor.dart#L98\u0007MessageProcessor<T>\u001b[m\u001b]8;;\u0007 consumes \u001b[94mAgentToRendererMessage\u001b[ms, validates them against\r\n  catalog schemas (\u001b[94mPayloadValidator\u001b[m) and component graph topology (\u001b[94mValidationConfig\u001b[m), and applies them to\u001b[K\r\n  \u001b[34;4m\u001b]8;id=jk249b912412a9f640;file:///Users/brett/.pub-cache/hosted/pub.dev/a2ui_core-0.5.0/lib"]
