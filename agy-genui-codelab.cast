[0.000, "o", " & Outbound RPC Messages Are Not Forwarded in the Live App\u001b[m\r\n\n  In \u001b[34;4m\u001b]8;id=jk5ee73013534835b5;file:///Users/brett/tmp/agy_genui_demo/lib/ui/features/chat/view_models/chat_view_model.dart#L20-L28\u0007ChatViewModel\u001b[m\u001b]8;;\u0007, both \u001b[94mforwardSurfaceActionsToAgent\u001b[m and \u001b[94mforwardRpcMessagesToAgent\u001b[m default to \u001b[94mfalse\u001b[m:\n\n\u001b[97D\u001b[38;5;70;1mthis\u001b[38;5;252;22m.forwardSurfaceActionsToAgent = \u001b[38;5;70;1mfalse\u001b[38;5;252;22m,\u001b[m\n\u001b[42D\u001b[38;5;70;1mthis\u001b[38;5;252;22m.forwardRpcMessagesToAgent = \u001b[38;5;70;1mfalse\u001b[38;5;252;22m,\u001b[m\r\n\n  Because \u001b[34;4m\u001b]8;id=jk17e5e44bb7088287;file:///Users/brett/tmp/agy_genui_demo/lib/main.dart#L22\u0007MarkdownChatApp\u001b[m\u001b]8;;\u0007 instantiates \u001b[94mChatViewModel()\u001b[m with default parameters, clicking interactive submit buttons\r\n  on \u001b[94mA2uiSurface\u001b[m cards or executing agent-initiated \u001b[94mcallRendererFunction\u001b[m calls in the live desktop app only appends\r\n  to \u001b[94m_threadActions\u001b[m / \u001b[94m_threadOutboundRpcMessages\u001b[m without sending the response turn back to the Antigravity agent"]
