[0.018, "o", "\u001b[?2026h\r\u001b[27A  \u001b[1m### \u001b[m\u001b[1mSummary of\u001b[m\u001b[1m Fixes\u001b[m\u001b[K\r\n\u001b[?5W\u001b[J\n  1. \u001b[1mEnabled Automatic A2UI Surface Action & Outbound RPC Forwarding in Production (\u001b[34;4m\u001b]8;id=jk16cbae17b67e654e;file:///Users/brett/tmp/agy_genui_demo/lib/main.dart#L21-L27\u0007m\u001b[22main.dart:21-27\u001b[39;24;1m\u001b]8;;\u0007)\u001b[m:\n\u001b[95D\u2022 Configured the default \u001b[34;4m\u001b]8;id=jkfba65f948b3df63c;file:///Users/brett/tmp/agy_genui_demo/lib/ui/features/chat/view_models/chat_view_model.dart#L20\u0007ChatViewModel\u001b[m\u001b]8;;\u0007 in \u001b[34;4m\u001b]8;id=jkef7188e4c4d5041c;file:///Users/brett/tmp/agy_genui_demo/lib/main.dart#L12\u0007MarkdownChatApp\u001b[m\u001b]8;;\u0007 with \u001b[94mforwardSurfaceActionsToAgent: true\u001b[m and\r\n\u001b[6C\u001b[94mforwardRpcMessagesToAgent: true\u001b[m so user surface interactions and renderer RPC responses are automatically sent\r\n\u001b[6Cto the Antigravity agent.\r\n  2. \u001b[1mBatched, Stream-Safe Outbound RPC Forwarding (\u001b[34;4m\u001b]8;id=jk1dcd0e60c85cfc2d;file:///Users/brett/tmp/agy_genui_demo/lib/ui/features/chat/view_models/chat_view_model.dart#L220-L253\u0007c\u001b[22mhat_view_model.dart:2"]
[0.0, "o", "20-253\u001b[39;24;1m\u001b]8;;\u0007)\u001b[m:\n\u001b[75D\u2022 Added \u001b[34;4m\u001b]8;id=jkae650361173fc50d;file:///Users/brett/tmp/agy_genui_demo/lib/ui/features/chat/view_models/chat_view_model.dart#L235\u0007_enqueueOutboundRpcForForwarding\u001b[m\u001b]8;;\u0007, \u001b[34;4m\u001b]8;id=jka358c94f66cbdcb3;file:///Users/brett/tmp/agy_genui_demo/lib/ui/features/chat/view_models/chat_view_model.dart#L256\u0007_flushPendingAutoForwardRpcMessages\u001b[m\u001b]8;;\u0007, and \u001b[34;4m\u001b]8;id=jk90f1df231a01ccce;file:///Users/brett/tmp/agy_genui_demo/lib/ui/features/chat/view_models/chat_view_model.dart#L773\u0007sendRpcMessagesToAgent\u001b[m\u001b]8;;\u0007.\r\n\u001b[6C\u2022 Outbound RPC messages emitted while an assistant reply is still streaming are queued and flushed in a single\r\n\u001b[6Cbatched \u001b[94mRendererToAgentMessagePayload\u001b[m turn when the stream completes (\u001b[94monDone\u001b[m), preventing mid-stream\r\n\u001b[6Ccancellation and multi-RPC race conditions.\r\n  3. \u001b[1mPreserved Custom Thread Titles on First Message (\u001b[34;4m\u001b]8;id=jk2f0c16531a7ef7c8;file:///Users/brett/tmp/agy_genui_demo/lib/ui/features/chat/view_models/chat_view"]
[0.0, "o", "_model.dart#L691\u0007c\u001b[22mhat_view_model.dart:691\u001b[39;24;1m\u001b]8;;\u0007)\u001b[m:\n\u001b[74D\u2022 Updated \u001b[34;4m\u001b]8;id=jkba02211822072f1e;file:///Users/brett/tmp/agy_genui_demo/lib/ui/features/chat/view_models/chat_view_model.dart#L667\u0007ChatViewModel.sendMessage\u001b[m\u001b]8;;\u0007 to check \u001b[94m!current.isAutoTitled\u001b[m so explicitly renamed empty threads keep\r\n\u001b[6Ctheir custom title when the first message is sent.\r\n  4. \u001b[1mHardened Sandbox-Escape Path Heuristics (\u001b[34;4m\u001b]8;id=jke534454d316b0343;file:///Users/brett/tmp/agy_genui_demo/lib/data/repositories/chat_repository.dart#L315-L398\u0007c\u001b[22mhat_repository.dart:315-398\u001b[39;24;1m\u001b]8;;\u0007)\u001b[m:\n\u001b[70D\u2022 Updated \u001b[34;4m\u001b]8;id=jk1952a7e2e8e9e6e7;file:///Users/brett/tmp/agy_genui_demo/lib/data/repositories/chat_repository.dart#L315\u0007ChatRepository.findOutsideWorkspacePathInCommand\u001b[m\u001b]8;;\u0007 to inspect \u001b[94m--flag=/path\u001b[m and \u001b[94mKEY=/path\u001b[m assignments,\r\n\u001b[6Cexpand \u001b[94m$HOME\u001b[m/\u001b[94m${HOME}\u001b[m and \u001b[94m$TMPDIR\u001b[m/\u001b[94m${TMPDIR}\u001b[m prefixes, catch trailing \u001b[94m/..\u001b[m segments, and ignore single"]
[0.0, "o", "-segment\r\n\u001b[6C\u001b[94m/regex/\u001b[m literals (e.g., \u001b[94mawk '/pattern/'\u001b[m).\r\n  5. \u001b[1mBounded Synchronous Directory Scans & Widget Cleanup\u001b[m:\n\u001b[52D\u2022 Added cancellation checking and a scan limit (\u001b[94mmaxScannedEntries = 1000\u001b[m) to \u001b[34;4m\u001b]8;id=jk734f68f6dda413d3;file:///Users/brett/tmp/agy_genui_demo/lib/data/catalog/renderer_rpc_functions.dart#L179-L199\u0007ListWorkspaceFilesFunction.execute\u001b[m\u001b]8;;\u0007.\r\n\u001b[6C\u2022 Reset the \u001b[94m_copied\u001b[m state in \u001b[34;4m\u001b]8;id=jk40a194b51e2de6bd;file:///Users/brett/tmp/agy_genui_demo/lib/ui/features/chat/views/widgets/message_bubble.dart#L40-L44\u0007MessageBubble.didUpdateWidget\u001b[m\u001b]8;;\u0007 when the message ID changes.\n\u001b[87D\u2022 Removed the unused \u001b[94mcupertino_icons\u001b[m dependency in \u001b[34;4m\u001b]8;id=jk2dc0624d9f622b2c;file:///Users/brett/tmp/agy_genui_demo/pubspec.yaml#L30-L35\u0007pubspec.yaml:30-35\u001b[m\u001b]8;;\u0007 and fixed section numbering in\r\n\u001b[6C\u001b[34;4m\u001b]8;id=jk12ba353b9b87f784;file:///Users/brett/tmp/agy_genui_demo/README.md#L19-L51\u0007README.md:19-51\u001b[m\u001b]8;;\u0007.\n\u001b[16D\u2022 Added regression tests in "]
