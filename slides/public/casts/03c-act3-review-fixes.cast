[0.065, "o", "\u001b[?2026h\r\u001b[28A  \u2022 \u001b[1mHow \u001b[m\u001b[94mpackage:antigravity\u001b[m\u001b[1m separates these layers\u001b[m:\u001b[K\r\n      \u2022 \u001b[94mworkspaceOnly(workspaces)\u001b[m only confines \u001b[1mfile manipulation tools\u001b[m (\u001b[94mview_file\u001b[m, \u001b[94mcreate_file\u001b[m, \u001b[94medit_file\u001b[m) to the\u001b[K\r\n\u001b[?5W\u001b[J\u001b[6Cworkspace when paired with \u001b[94mallowAll()\u001b[m.\n\u001b[38D\u2022 \u001b[94mCapabilitiesConfig(runCommandConfig: RunCommandConfig(enableSandbox: true))\u001b[m enables the \u001b[94mlocalharness\u001b[m OS-level\r\n\u001b[6Ccommand sandbox (\u001b[94mexebox\u001b[m) so standard \u001b[94mrun_command\u001b[m executions (\u001b[94mBypassSandbox: false\u001b[m) run confined to the project\r\n\u001b[6Cworkspace.\n\u001b[10D\u2022 Commands that want to escape the sandbox either set \u001b[94mBypassSandbox: true\u001b[m on \u001b[94mrun_command\u001b[m, reference paths\r\n\u001b[6Coutside the project workspace, or are flagged by \u001b[94mauto(handler: ...)\u001b[m.\r\n  \u2022 \u001b[1mImplementation\u001b[m:\n\u001b[13D\u2022 \u001b[34;4m\u001b]8;id=jkc71847d70cd61eb2;file:///Users/brett/tmp/agy_genui_demo/lib/data/repositories/chat_repository.dart#L294-L364\u0007ChatRepository.buildAgentConfig\u001b[m\u001b]8;;\u0007 conf"]
