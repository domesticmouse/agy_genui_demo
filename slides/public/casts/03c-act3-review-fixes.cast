[0.032, "o", "\u001b[?2026h\u001b[29A\u2022 \u001b[1mHow \u001b[94;22mpackage:antigravity\u001b[39;1m separates these layers\u001b[m:\r\n      \u2022 \u001b[94mworkspaceOnly(workspaces)\u001b[m only confines \u001b[1mfile manipulation tools\u001b[m (\u001b[94mview_file\u001b[m, \u001b[94mcreate_file\u001b[m, \u001b[94medit_file\u001b[m) to the\r\n\u001b[6Cworkspace when paired with \u001b[94mallowAll()\u001b[m.\u001b[K\n\u001b[38D\u2022 \u001b[94mCapabilitiesConfig(runCommandConfig: RunCommandConfig(enableSandbox: true))\u001b[m enables the \u001b[94mlocalharness\u001b[m OS-level\r\n\u001b[6Ccommand sandbox (\u001b[94mexebox\u001b[m) so standard \u001b[94mrun_command\u001b[m executions (\u001b[94mBypassSandbox: false\u001b[m) run confined to the project\u001b[K\r\n\u001b[6Cworkspace.\u001b[K\n\u001b[10D\u2022 Commands that want to escape the sandbox either set \u001b[94mBypassSandbox: true\u001b[m on \u001b[94mrun_command\u001b[m, reference paths\r\n\u001b[6Coutside the project workspace, or are flagged by \u001b[94mauto(handler: ...)\u001b[m.\u001b[K\r\n  \u2022 \u001b[1mImplementation\u001b[m:\u001b[K\r\n      \u2022 \u001b[34;4m\u001b]8;id=jkc71847d70cd61eb2;file:///Users/brett/tmp/agy_genui_demo/lib/data/repositories/chat_repository.dart#L294-L364\u0007ChatRepository.buildAgentConfig\u001b[m\u001b]8;;\u0007 conf"]
[0.0, "o", "igures \u001b[94mRunCommandConfig(enableSandbox: true)\u001b[m alongside\n\u001b[92D\u001b[94mworkspaceOnly(resolvedWorkspaces)\u001b[m, an \u001b[94maskUser\u001b[m policy on \u001b[94mrun_command\u001b[m matching\u001b[K\n\u001b[76D\u001b[34;4m\u001b]8;id=jk7f1cf8bef44bf530;file:///Users/brett/tmp/agy_genui_demo/lib/data/repositories/chat_repository.dart#L221-L230\u0007ChatRepository.isSandboxEscapeToolCall\u001b[m\u001b]8;;\u0007, \u001b[94mauto(handler: ...)\u001b[m, and \u001b[94mallowAll()\u001b[m.\u001b[K\n\u001b[75D\u2022 Added \u001b[34;4m\u001b]8;id=jk1ce765b6e1bd10ca;file:///Users/brett/tmp/agy_genui_demo/lib/domain/models/chat_models.dart#L102-L130\u0007PendingCommandReview\u001b[m\u001b]8;;\u0007 and \u001b[34;4m\u001b]8;id=jk543d7bdc16d0b491;file:///Users/brett/tmp/agy_genui_demo/lib/ui/features/chat/views/widgets/sandbox_review_banner.dart\u0007SandboxReviewBanner\u001b[m\u001b]8;;\u0007, rendered in \u001b[34;4m\u001b]8;id=jk28f629f9343c81f6;file:///Users/brett/tmp/agy_genui_demo/lib/ui/features/chat/views/chat_screen.dart#L115-L119\u0007ChatScreen\u001b[m\u001b]8;;\u0007 above the composer whenever a\r\n\u001b[6Ccommand requests to escape the sandbox, allowing the user to inspect the command line, project "]
