[0.0, "o", "[1mYe\u001b[m \u2502 If your backend server already parses LLM\u001b[K\n\u001b[60D\u001b[1K \u2502 \u001b[4b\u2502    \u2502 \u001b[1ms\u001b[m  \u2502 output and streams pre-parsed A2UI JSON\u001b[K\n\u001b[6Z   \u2502 messages (\u001b[94mcreateSurface\u001b[m, \u001b[94mupdateComponents\u001b[m,\n\u001b[42D\u001b[94mupdateDataModel\u001b[m) over WebSockets/SSE/gRPC, the\n\u001b[46DFlutter client only needs\u001b[K\n\u001b[25D\u001b[94mMessageProcessor<ComponentImplementation>\u001b[m\n\u001b[41D(\u001b[94ma2ui_core\u001b[m) and \u001b[94mA2uiSurface\u001b[m (\u001b[94ma2ui_flutter\u001b[m).\r\n   \u001b[1m3. Dart Backend Agent Server / CLI\u001b[m \u001b[3m(serving\u001b[m \u001b[4b\u2502 \u001b[1mYes\u001b[m \u2502 \u001b[1mYe\u001b[m \u2502 \u001b[3mNo\u001b[m \u2502 A pure Dart server (shelf, dart_frog, CLI)\u001b[K\r\n   \u001b[3mWeb, iOS, or Flutter clients)\u001b[m\u001b[19X\u001b[19C\u2502 \u001b[4b\u2502 \u001b[1ms\u001b[m  \u2502    \u2502 cannot depend on \u001b[94mflutter\u001b[m. It uses\u001b[K\n\u001b[52D\u001b[1K \u2502 \u001b[4b\u2502    \u2502    \u2502 \u001b[94mBasicCatalog.v1_0()\u001b[m from \u001b[94ma2ui_core\u001b[m and\n\u001b[38D\u001b[94mA2uiGenerator\u001b[m / \u001b[94mA2uiRequestProcessor\u001b[m /\n\u001b[38D\u001b[94mRendererState\u001b[m from \u001b[94ma2ui_agent\u001b[m to prompt the\n\u001b[43DLLM, heal/validate streaming \u001b[94m<a2ui-json>\u001b[m, and\n\u001b[45Dforward validated \u001b[9"]
[0.0, "o", "4mAgentToRendererMessage\u001b[ms to\u001b[K\n\u001b[44Dclients.\u001b[K\r\n   \u001b[1m4. Custom Non-Flutter Dart Renderer / Headless\u001b[m  \u2502 \u001b[1mYes\u001b[m \u2502 \u001b[3mOp\u001b[m \u2502 \u001b[3mNo\u001b[m \u2502 Implement your own subclass of \u001b[94mComponentApi\u001b[m and\r\n   \u001b[1mTesting\u001b[m \u001b[3m(e.g. JASPR, terminal UI, or unit\u001b[m \u001b[6b\u2502 \u001b[4b\u2502 \u001b[3mti\u001b[m \u2502    \u2502 mount \u001b[94mNodeResolver<MyComponent>\u001b[m from \u001b[94ma2ui_core\u001b[m\u001b[K\r\n   \u001b[3mtests)\u001b[m\u001b[42X\u001b[42C\u2502 \u001b[4b\u2502 \u001b[3mon\u001b[m \u2502    \u2502 to render surfaces into another UI target or\u001b[K\n\u001b[63D\u001b[1K \u2502 \u001b[4b\u2502 \u001b[3mal\u001b[m \u2502    \u2502 inspect resolved \u001b[94mComponentNode\u001b[m trees headlessly\n\u001b[57D   \u2502    \u2502 in unit\u001b[K\n\n\n\n\u001b[74D\u001b[?2026l"]
