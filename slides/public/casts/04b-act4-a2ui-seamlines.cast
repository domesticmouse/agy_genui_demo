[0.0, "o", ".0/lib/src/component_implementation.dart#L29\u0007ComponentWidgetBuilder\u001b[m\u001b]8;;\u0007 (\u001b[94mWidget Function(BuildContext, ComponentNode<ComponentImplementation>, ComponentProps,\u001b[m\r\n  \u001b[94mChildWidgetBuilder)\u001b[m) to each component's JSON Schema.\r\n  \u2022 \u001b[1mFlutter Basic Catalog\u001b[m: \u001b[34;4m\u001b]8;id=jkf8fc1379314da11f;file:///Users/brett/.pub-cache/hosted/pub.dev/a2ui_flutter-0.1.0/lib/src/catalog/basic/basic_catalog.dart#L43\u0007basicCatalog()\u001b[m\u001b]8;;\u0007 returns a \u001b[34;4m\u001b]8;id=jke5e636dc4bae7e35;file:///Users/brett/.pub-cache/hosted/pub.dev/a2ui_flutter-0.1.0/lib/src/component_implementation.dart#L64\u0007CatalogImplementation\u001b[m\u001b]8;;\u0007 (\u001b[94mCatalog<ComponentImplementation,\u001b[m\r\n  \u001b[94mFunctionImplementation>\u001b[m) implementing all 18 A2UI v1.0 basic components (\u001b[94mCard\u001b[m, \u001b[94mRow\u001b[m, \u001b[94mColumn\u001b[m, \u001b[94mList\u001b[m, \u001b[94mTabs\u001b[m, \u001b[94mModal\u001b[m, \u001b[94mText\u001b[m,\r\n  \u001b[94mImage\u001b[m, \u001b[94mIcon\u001b[m, \u001b[94mVideo\u001b[m, \u001b[94mAudioPlayer\u001b[m, \u001b[94mDivider\u001b[m, \u001b[94mButton\u001b[m, \u001b[94mTextField\u001b[m, \u001b[94mCheckBox\u001b[m, \u001b[94mChoicePicker\u001b[m, \u001b[94mSlider\u001b[m, "]
[0.0, "o", "\u001b[94mDateTimeInput\u001b[m).\r\n  \u2022 \u001b[1mReactive Surface Widget\u001b[m: \u001b[34;4m\u001b]8;id=jk2c3ebf261123492b;file:///Users/brett/.pub-cache/hosted/pub.dev/a2ui_flutter-0.1.0/lib/src/a2ui_surface.dart#L35\u0007A2uiSurface\u001b[m\u001b]8;;\u0007 takes a \u001b[94mSurfaceModel<ComponentImplementation>\u001b[m, attaches a\r\n  \u001b[94mNodeResolver<ComponentImplementation>\u001b[m, and rebuilds only the affected widget subtrees as signals in the surface's\r\n  component/data models change.\r\n  \u2500\u2500\u2500\u2500\u2500\u2500\r\n  \u001b[1m## 2. The Exact Seamlines Between the Packages\u001b[m\r\n\n  There are \u001b[1mfour key seamlines\u001b[m where these packages connect:\r\n\n  \u001b[1m### Seamline 1: \u001b[94mComponentApi\u001b[39m \u2194 \u001b[94mComponentImplementation\u001b[39m (\u001b[94ma2ui_core\u001b[39m \u2194 \u001b[94ma2ui_flutter\u001b[39m & \u001b[94ma2ui_agent\u001b[39m)\u001b[m\r\n\n  \u001b[94ma2ui_core\u001b[m is generic over \u001b[94mT extends ComponentApi\u001b[m.\r\n\n  \u2022 A backend-only agent uses \u001b[94mCatalogApi\u001b[m (\u001b[94mCatalog<ComponentApi, FunctionApi>\u001b[m), which only carries JSON Schemas\r\n  (\u001b[94mBasicCatalog.v1_0()\u001b[m).\r\n  \u2022 A Flutter app uses \u001b[34;4m\u001b]8;id=jke5"]
