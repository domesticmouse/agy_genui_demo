[0.0, "o", "\u001b[?25l\u001b[?5W\u001b[2J\u001b[3J\u001b[30;3H\u001b[?2026h\u001b[29A1. \u001b[1mDependencies (\u001b[34;4m\u001b]8;id=jk9bb9ae784dd2d949;file:///Users/brett/tmp/agy_genui_demo/pubspec.yaml\u0007p\u001b[22mubspec.yaml\u001b[39;24;1m\u001b]8;;\u0007)\u001b[m\r\n      \u2022 Added \u001b[94ma2ui_core: ^0.5.0\u001b[m, \u001b[94ma2ui_agent: ^0.1.0\u001b[m, and \u001b[94ma2ui_flutter: ^0.1.0\u001b[m.\r\n  2. \u001b[1mA2UI v1.0 Catalog, Prompt Negotiation & Starter Surface (\u001b[34;4m\u001b]8;id=jkc4a644398c3d0e69;file:///Users/brett/tmp/agy_genui_demo/lib/data/repositories/chat_repository.dart\u0007c\u001b[22mhat_repository.dart\u001b[39;24;1m\u001b]8;;\u0007)\u001b[m\r\n      \u2022 Configured \u001b[34;4m\u001b]8;id=jk4268a6a749d3711f;file:///Users/brett/tmp/agy_genui_demo/lib/data/repositories/chat_repository.dart#L103\u0007ChatRepository.defaultA2uiCatalog\u001b[m\u001b]8;;\u0007 (\u001b[94mbasicCatalog()\u001b[m), \u001b[34;4m\u001b]8;id=jka2adf32de710e1fe;file:///Users/brett/tmp/agy_genui_demo/lib/data/repositories/chat_repository.dart#L107-L108\u0007ChatRepository.defaultA2uiFormatFactory\u001b[m\u001b]8;;\u0007\r\n\u001b[6C(\u001b[94mDirectJsonFormatFactory(progressiveKeys: {'text', 'label'})\u001b[m), \u001b[34;4m\u001b]8;id=jk9c68f970924bb995;file:///Users/brett/tmp/agy_genui_demo/lib/data/repositories/chat_repository.dart#L133-L136\u0007ChatRepository.a2uiGenerator\u001b[m\u001b]8;;\u0007, and\u001b[K\n\u001b[96D\u001b[34;4m\u001b]8;id=jk3ba70704c6db90d5;file:///Users/brett/tmp/agy_genui_demo/lib/data/repositories/chat_repository.dart#L140-L146\u0007ChatRepository.a2uiRequestProcessor\u001b[m\u001b]8;;\u0007 (\u001b[94mA2uiProtocolVersion.v1_0\u001b[m).\u001b[K\n\u001b[63D\u2022 Updated \u001b[34;4m\u001b]8;id=jka77a01c33e456fd;file:///Users/brett/tmp/agy_genui_demo/lib/data/repositories/chat_repository.dart#L365-L416\u0007ChatRepository.buildAgentConfig\u001b[m\u001b]8;;\u0007 to append \u001b[34;4m\u001b]8;id=jk19d9d87d95ded2ea;file:///Users/brett/tmp/agy_genui_demo/lib/data/repositories/chat_repository.dart#L150\u0007a2uiPromptSnippet\u001b[m\u001b]8;;\u0007 (\u001b[94ma2uiRequestProcessor.promptSnippet\u001b[m) to\r\n\u001b[6C\u001b[94mCustomSystemInstructions\u001b[m.\u001b[K\n\u001b[25D\u2022 Added a live \u001b[94m<a2ui-json>\u001b[m v1.0 surface showcase in \u001b[34;4m\u001b]8;id=jke32547b2aba8b03d;file:///Users/brett/tmp/agy_genui_demo/lib/data/repositories/chat_repository.dart#L646-L717\u0007ChatRepository.getStarterThreads\u001b[m\u001b]8;;\u0007.\r\n  3. \u001b[1mMessage Model & Streaming Parser Integration (\u001b[34;4m\u001b]8;id=jkcc3695a6035ddcb0;file:///Users/brett/tmp/agy_genui_demo/lib/domain/models/chat_models.dart\u0007c\u001b[22mhat_models.dart\u001b[39;24;1m\u001b]8;;\u0007, \u001b[34;4m\u001b]8;id=jk5f1c2d534c5b014b;file:///Users/brett/tmp/agy_genui_demo/lib/ui/features/chat/view_models/chat_view_model.dart\u0007c\u001b[22mhat_view_model.dart\u001b[39;24;1m\u001b]8;;\u0007)\u001b[m\u001b[K\r\n      \u2022 Extended \u001b[34;4m\u001b]8;id=jk18012e7031d13729;file:///Users/brett/tmp/agy_genui_demo/lib/domain/models/chat_models.dart#L62-L120\u0007ChatMessage\u001b[m\u001b]8;;\u0007 with \u001b[94mparts\u001b[m (\u001b[94mList<AnswerPart<ComponentImplementation>>\u001b[m), \u001b[94mhasParsedParts\u001b[m, \u001b[94msurfaces\u001b[m, and\r\n\u001b[6C\u001b[94ma2uiErrors\u001b[m.\u001b[K\n\u001b[11D\u2022 Added per-thread \u001b[94mMessageProcessor<ComponentImplementation>\u001b[m management via \u001b[34;4m\u001b]8;id=jk720027d096101ad5;file:///Users/brett/tmp/agy_genui_demo/lib/ui/features/chat/view_models/chat_view_model.dart#L119-L140\u0007ChatViewModel.rendererForThread\u001b[m\u001b]8;;\u0007,\r\n\u001b[6C\u001b[94mStreamedAnswer<ComponentImplementation>\u001b[m incremental parsing in \u001b[34;4m\u001b]8;id=jk41ae6da8309e2c2b;file:///Users/brett/tmp/agy_genui_demo/lib/ui/features/chat/view_models/chat_view_model.dart#L650-L747\u0007ChatViewModel._streamAssistantTurn\u001b[m\u001b]8;;\u0007, and A2UI v1.\r\n\u001b[6C0 action forwarding via \u001b[34;4m\u001b]8;id=jk987cc7008c933dc6;file:///Users/brett/tmp/agy_genui_demo/lib/ui/features/chat/view_models/chat_view_model.dart#L610-L648\u0007ChatViewModel.sendSurfaceAction\u001b[m\u001b]8;;\u0007.\u001b[K\r\n  4. \u001b[1mInline \u001b[94;22mA2uiSurface\u001b[39;1m & Markdown Rendering (\u001b[34;4m\u001b]8;id=jk72c7ab9504f2e078;file:///Users/brett/tmp/agy_genui_demo/lib/ui/features/chat/views/widgets/message_bubble.dart\u0007m\u001b[22message_bubble.dart\u001b[39;24;1m\u001b]8;;\u0007, \u001b[34;4m\u001b]8;id=jk4374ee276161409e;file:///Users/brett/tmp/agy_genui_demo/lib/ui/features/chat/views/widgets/thread_sidebar.dart\u0007t\u001b[22mhread_sidebar.dart\u001b[39;24;1m\u001b]8;;\u0007, \u001b[34;4m\u001b]8;id=jk228552119896b75d;file:///Users/brett/tmp/agy_genui_demo/lib/ui/features/chat/views/chat_screen.dart\u0007c\u001b[22mhat_screen.dart\u001b[39;24;1m\u001b]8;;\u0007)\u001b[m\r\n      \u2022 Updated \u001b[34;4m\u001b]8;id=jkad028dab9051a039;file:///Users/brett/tmp/agy_genui_demo/lib/ui/features/chat/views/widgets/message_bubble.dart#L135-L209\u0007MessageBubble\u001b[m\u001b]8;;\u0007 to render \u001b[94mAnswerTextPart\u001b[m with \u001b[94mMarkdownBody\u001b[m, \u001b[94mAnswerSurfacePart\u001b[m with\u001b[K\n\u001b[90D\u001b[34;4m\u001b]8;id=jk90fb355cd285f33e;file:///Users/brett/tmp/agy_genui_demo/lib/ui/features/chat/views/widgets/message_bubble.dart#L311-L350\u0007_InlineA2uiSurfaceCard\u001b[m\u001b]8;;\u0007 (\u001b[94mA2uiMarkdown\u001b[m + \u001b[94mA2uiSurface(key: ObjectKey(surface), surface: surface)\u001b[m), and\n\u001b[99D\u001b[94mAnswerErrorPart\u001b[m with \u001b[34;4m\u001b]8;id=jkdcdaa8ac38c0e60d;file:///Users/brett/tmp/agy_genui_demo/lib/ui/features/chat/views/widgets/message_bubble.dart#L352-L386\u0007_InlineA2uiErrorBanner\u001b[m\u001b]8;;\u0007.\u001b[K\n\u001b[44D\u2022 Updated \u001b[34;4m\u001b]8;id=jk8ee30db151dccd71;file:///Users/brett/tmp/agy_genui_demo/lib/ui/features/chat/views/widgets/thread_sidebar.dart#L322-L341\u0007ThreadSidebar._previewSnippet\u001b[m\u001b]8;;\u0007 to strip \u001b[94m<a2ui-json>\u001b[m blocks from thread preview snippets.\r\n  5. \u001b[1mVerification (\u001b[34;4m\u001b]8;id=jkf7cc321a3707149b;file:///Users/brett/tmp/agy_genui_demo/test/widget_test.dart\u0007w\u001b[22midget_test.dart\u001b[39;24;1m\u001b]8;;\u0007)\u001b[m\u001b[K\r\n      \u2022 Added widget tests covering incremental \u001b[94m<a2ui-json>\u001b[m v1.0 streaming, live data-model binding updates,\r\n\u001b[6Cinteractive \u001b[94mA2uiSurface\u001b[m actions (\u001b[94mTextField\u001b[m, \u001b[94mCheckBox\u001b[m, \u001b[94mButton\u001b[m), \u001b[94mActionMessage\u001b[m forwarding, and inline error\r\n\u001b[6Crecovery on rejected \u001b[94m<a2ui-json>\u001b[m blocks.\u001b[K\n\u001b[40D\u2022 Co\u001b[K\n\n\u001b[6D\u001b[94mo\u001b[90mr\u001b[m\n\n\n\u001b[4D\u001b[?2026l\u001b[?2026h\u001b[29A\u001b[17C\u001b[34;1;4m\u001b]8;id=jk6fa9bd7ec1bea434;file:///Users/brett/tmp/agy_genui_demo/pubspec.yaml\u0007p\u001b[22mubspec.yaml\u001b[m\u001b]8;;\u0007\n\n\u001b[31C\u001b[34;1;4m\u001b]8;id=jkd19a012f85940b04;file:///Users/brett/tmp/agy_genui_demo/lib/data/repositories/chat_repository.dart\u0007c\u001b[22mhat_repository.dart\u001b[m\u001b]8;;\u0007\n\u001b[63D\u001b[34;4m\u001b]8;id=jke2af50e0cf2ac354;file:///Users/brett/tmp/agy_genui_demo/lib/data/repositories/chat_repository.dart#L103\u0007ChatRepository.defaultA2uiCatalog\u001b[m\u001b]8;;\u0007 (\u001b[94mbasicCatalog()\u001b[m), \u001b[34;4m\u001b]8;id=jkb52fa5a29a3b47b7;file:///Users/brett/tmp/agy_genui_demo/lib/data/repositories/chat_repository.dart#L107-L108\u0007ChatRepository.defaultA2uiFormatFactory\u001b[m\u001b]8;;\u0007\n\u001b[41D\u001b[34;4m\u001b]8;id=jk2ee3c2cefa2776a4;file:///Users/brett/tmp/agy_genui_demo/lib/data/repositories/chat_repository.dart#L133-L136\u0007ChatRepository.a2uiGenerator\u001b[m\u001b]8;;\u0007\n\u001b[91D\u001b[34;4m\u001b]8;i