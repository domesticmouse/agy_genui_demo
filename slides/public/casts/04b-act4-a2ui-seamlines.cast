[0.0, "o", "es/chat/view_models/chat_view_model.dart#L125-L129\u001b[m\u001b]8;;\u0007 (which\r\n\u001b[6C\u001b[94ma2ui_flutter\u001b[m reads \u001b[94m.builder\u001b[m from to build widgets).\r\n\n\n  \u001b[1m### Seamline 2: \u001b[94mA2uiRequestProcessor\u001b[39m \u2194 \u001b[94mMessageProcessor<T>\u001b[39m (\u001b[94ma2ui_agent\u001b[39m \u2194 \u001b[94ma2ui_core\u001b[39m)\u001b[m\r\n\n  Notice the doc comment in \u001b[34;4m\u001b]8;id=jkbabcd36164a1eda;file:///Users/brett/.pub-cache/hosted/pub.dev/a2ui_core-0.5.0/lib/src/processing/processor.dart#L63-L65\u0007MessageProcessor\u001b[m\u001b]8;;\u0007:\r\n\n  \u2502 \u001b[3mNot to be confused with the Agent SDK's \u001b[94;23mA2uiRequestProcessor\u001b[39;3m, which runs the other way: it parses model output\u001b[m\r\n  \u2502 \u001b[3minto the payloads this consumes.\u001b[m\r\n\n  \u2022 \u001b[94mA2uiRequestProcessor\u001b[39;1m (\u001b[94;22ma2ui_agent\u001b[39;1m)\u001b[m: Converts \u001b[1mraw LLM text chunks\u001b[m (\u001b[94mString\u001b[m containing Markdown + \u001b[94m<a2ui-json>...\u001b[m\r\n  \u001b[94m</a2ui-json>\u001b[m) \u2192 \u001b[94mList<AgentToRendererMessage>\u001b[m.\r\n  \u2022 \u001b[94mMessageProcessor<T>\u001b[39;1m (\u001b[94;22ma2ui_core\u001b[39;1m)\u001b[m: Consumes \u001b[94mList<AgentToRendererMessage>\u001b[m \u2192 mutate"]
[0.0, "o", "s \u001b[94mSurfaceGroupModel<T>\u001b[m /\r\n  \u001b[94mSurfaceModel<T>\u001b[m.\r\n  \u2022 \u001b[1mHow they connect\u001b[m:\n\u001b[15D\u2022 \u001b[1mRemote Agent / Client split (over HTTP/WebSockets/gRPC)\u001b[m: The server runs \u001b[94mA2uiRequestProcessor.\u001b[m\n\u001b[96D\u001b[94mopenContinuingStream()\u001b[m and serializes the resulting \u001b[94mAgentToRendererMessage\u001b[ms over the wire; the Flutter client\r\n\u001b[6Cfeeds those decoded JSON messages directly into \u001b[94mMessageProcessor<ComponentImplementation>.processMessages(...)\u001b[m.\r\n\u001b[6C\u2022 \u001b[1mIn-Process Agent + Renderer (like this app)\u001b[m: \u001b[34;4m\u001b]8;id=jkf37ac234e2b6ce9;file:///Users/brett/.pub-cache/hosted/pub.dev/a2ui_agent-0.1.0/lib/src/utils/renderer_state.dart#L123\u0007RendererState.of(renderer)\u001b[m\u001b]8;;\u0007 and\n\u001b[77D\u001b[34;4m\u001b]8;id=jk9835269834596f65;file:///Users/brett/.pub-cache/hosted/pub.dev/a2ui_agent-0.1.0/lib/src/processor/streamed_answer.dart#L65\u0007StreamedAnswer<ComponentImplementation>\u001b[m\u001b]8;;\u0007 wrap the UI's \u001b[94mMessageProcessor<ComponentImplementation>\u001b[m directly so\r\n\u001b[6C\u001b[94mA2uiRequestProcessor\u001b[m validates and appl"]
[0.0, "o", "ies messages straight into the live renderer in a single pass, emitting\r\n\u001b[6C[\u001b[94mAnswerTextPart\u001b[m](file:///Users/brett/.pub-cache/hosted/pub.dev/a2ui_agent-0.1.\n\u001b[78D0/lib/src/processor/streamed_answer\r\n\n\u287f  \u001b[94mLoadi\u001b[90mng...\u001b[m\r\n\u001b[90m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[m\r\n\u001b[94m>\u001b[m\r\n\u001b[90m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[m\r\n\u001b[90mesc to cancel\u001b[m\u001b[84X\u001b[84C\u001b[2mG"]
