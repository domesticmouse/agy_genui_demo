[0.0, "o", "d\u001b[m\u001b]8;;\u0007 to \u001b[94mprojectId\u001b[m.\r\n\u001b[4C\u001b[1mSafe Default & Workspace Configuration\u001b[m:\u001b[K\r\n      \u2022 \u001b[34;4m\u001b]8;id=jk26a4ae54e74bf30e;file:///Users/brett/tmp/agy_genui_demo/lib/data/repositories/chat_repository.dart#L132-L141\u0007ChatRepository.resolveDefaultWorkingDirectory\u001b[m\u001b]8;;\u0007 uses \u001b[94mDirectory.current.absolute.path\u001b[m when launched from a\r\n\u001b[6Cterminal, and falls back to \u001b[94m$HOME\u001b[m (or \u001b[94mDirectory.systemTemp\u001b[m) when \u001b[94mDirectory.current\u001b[m is \u001b[94m/\u001b[m (e.g., when a macOS \u001b[94m.\u001b[m\r\n\u001b[6C\u001b[94mapp\u001b[m bundle is launched from Finder).\u001b[K\n\u001b[36D\u2022 \u001b[34;4m\u001b]8;id=jk4d125a497efa373b;file:///Users/brett/tmp/agy_genui_demo/lib/data/repositories/chat_repository.dart#L294-L364\u0007ChatRepository.buildAgentConfig\u001b[m\u001b]8;;\u0007 passes the active project's normalized \u001b[94mworkingDirectory\u001b[m into\n\u001b[94D\u001b[94mLocalAgentConfig(workspaces: [activeDir], ...)\u001b[m.\u001b[K\n\u001b[47D\u2022 \u001b[34;4m\u001b]8;id=jk3e3d37cd69e64dda;file:///Users/brett/tmp/agy_genui_demo/lib/ui/features/chat/view_models/chat_view_model.dart#L179-L205\u0007ChatViewModel.upda"]
