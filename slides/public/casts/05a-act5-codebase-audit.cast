[0.0, "o", "m\u001b]8;;\u0007 pass.\u001b[K\r\n  \u2022 \u001b[1mClean Layered Architecture\u001b[m: Clear separation between immutable domain models (\u001b[34;4m\u001b]8;id=jkedbd5be561f884bc;file:///Users/brett/tmp/agy_genui_demo/lib/domain/models/chat_models.dart\u0007chat_models.dart\u001b[m\u001b]8;;\u0007), A2UI catalog/RPC\r\n  definitions (\u001b[34;4m\u001b]8;id=jkb9c15c74212c4c14;file:///Users/brett/tmp/agy_genui_demo/lib/data/catalog/renderer_rpc_functions.dart\u0007renderer_rpc_functions.dart\u001b[m\u001b]8;;\u0007), repository/session management (\u001b[34;4m\u001b]8;id=jk332983b5223c7372;file:///Users/brett/tmp/agy_genui_demo/lib/data/repositories/chat_repository.dart\u0007chat_repository.dart\u001b[m\u001b]8;;\u0007), and presentation\u001b[K\r\n  (\u001b[34;4m\u001b]8;id=jkb7aa79a779cc161f;file:///Users/brett/tmp/agy_genui_demo/lib/ui/features/chat/view_models/chat_view_model.dart\u0007chat_view_model.dart\u001b[m\u001b]8;;\u0007 + modular widgets).\u001b[K\r\n  \u2022 \u001b[1mTestability\u001b[m: \u001b[34;4m\u001b]8;id=jk34fb4e7b8e3d162a;file:///Users/brett/tmp/agy_genui_demo/lib/data/repositories/chat_repository.dart#L15-L24\u0007AntigravityAgentSession\u001b[m\u001b]8;;\u0007 and \u001b[34;4m\u001b]8;id=jk1e460bd"]
