[0.034, "o", "\u001b[?2026h\u001b[?25l\u001b[0 q\u001b[4A\u001b[C\u001b[33;1man\u001b[m \u001b[37m(find . -maxdepth 4 -not -path '*/.*' -not -path './build*' -not -path './ios*' -not -pa\u001b[m\r\n\u001b[K\n\u001b[33;1mCommand\u001b[m\u001b[K\r\n\n\u001b[K\n\u001b[37;1mRequesting permission for:\u001b[m\u001b[K\r\n\u001b[37m   find . -maxdepth 4 -not -path '*/.*' -not -path './build*' -not -path './ios*' -not -path './android*' -not\u001b[m\u001b[K\r\n\u001b[37m-path './macos*' -not -path './web*' -not -path './linux*' -not -path './windows*'\u001b[m\r\n\n\u001b[1mRun this command?\u001b[m\r\n\u001b[94m> 1. Yes, run command\u001b[K\u001b[m\r\n  2. Yes, and always allow in this conversation for commands that start with 'find . -maxdepth 4 -not -path '*/.*' -not\r\n-path './build*' -not -path './ios*' -...'\r\n  3. Yes, and always allow for commands that start with 'find . -maxdepth 4 -not -path '*/.*' -not -path './build*' -not\r\n-path './ios*' -...' (Persist to settings.json)\r\n  4. No, cancel\r\n\n  \u001b[94;1m\u2191/\u2193\u001b[90;22m Navigate \u00b7 \u001b[94;1mtab\u001b[90;22m Amend \u00b7 \u001b[94;1mctrl+g\u001b[90;22m edit/expand command\u001b[m\r\n\u001b[90mesc to cancel\u001b[m\u001b[84X\u001b[84C\u001b[2mGemini 4 Argon \u00b7 medium\r\u001b[m\u001b[?2026l"]
