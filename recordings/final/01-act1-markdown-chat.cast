[0.0, "o", "own\u001b[m button.\n\u001b[27D\u2022 \u001b[34;4m\u001b]8;id=jk7116aeb19edb68e2;file:///Users/brett/tmp/agy_genui_demo/lib/ui/features/chat/views/widgets/markdown_composer.dart\u0007markdown_composer.dart\u001b[m\u001b]8;;\u0007: Built \u001b[34;4m\u001b]8;id=jk66cb898127ed4700;file:///Users/brett/tmp/agy_genui_demo/lib/ui/features/chat/views/widgets/markdown_composer.dart#L11-L337\u0007MarkdownComposer\u001b[m\u001b]8;;\u0007 with a formatting toolbar (\u001b[94mBold\u001b[m, \u001b[94mItalic\u001b[m, \u001b[94mInline Code\u001b[m, \u001b[94mCode\u001b[m\r\n\u001b[6C\u001b[94mBlock\u001b[m, \u001b[94mList\u001b[m, \u001b[94mBlockquote\u001b[m), a \u001b[94mLive Preview\u001b[m toggle, \u001b[94mEnter\u001b[m / \u001b[94mNumpad Enter\u001b[m to send, \u001b[94mShift + Enter\u001b[m for newline, an\r\n\u001b[6Cactive IME composition guard, and focus restoration after sending.\n\u001b[66D\u2022 [chat_s\r\n\n\u28fb  \u001b[94mGene\u001b[90mrating...\u001b[m\r\n\u001b[90m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
