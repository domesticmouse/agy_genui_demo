[0.0, "o", "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[m\u001b[K\r\n\u001b[34;1m> git commit and tag as step-01-markdown-chat\u001b[m\u001b[K\r\n\u001b[K\n\u001b[33m\u25cf\u001b[m \u001b[33;1mRan\u001b[m 2 commands \u001b[37m(git status \u00b7 git add)\u001b[m \u001b[37m(ctrl+o to expand)\u001b[m\u001b[K\r\n\u001b[K\n\u001b[33;1mCommand\u001b[m\u001b[K\r\n\u001b[90m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[m\r\n\u001b[K\n\u001b[37;1mRequesting permission for:\u001b[m\r\n\u001b[37m   git add -A && git commit -m \"Build macOS desktop Markdown chat application with flutter_markdown_plus\" && git\u001b[m\r\n\u001b[37mtag step-01-markdown-chat\u001b[m\u001b[K\r\n\u001b[K\n\u001b[1mRun this command?\u001b[m\r\n\u001b[94m> 1. Yes, run command\u001b[K\u001b[m\r\n  2. Yes, and always allow in this conversation for commands that start with 'git add'\u001b[K\r\n"]
