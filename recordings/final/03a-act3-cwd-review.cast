[0.017, "o", "\u001b[?2026h\r\u001b[29A      \u2022 \u001b]8;id=jk17c346162f983ec0;file:///Users/brett/.pub-cache/hosted/pub.dev/antigravity-0.18.1/lib/src/connections/local/local_connection.dart#L437-L443\u001b\\\u001b[4;34;4mL\u001b[m\u001b[4;34;4mo\u001b[m\u001b[4;34;4mc\u001b[m\u001b[4;34;4ma\u001b[m\u001b[4;34;4ml\u001b[m\u001b[4;34;4mC\u001b[m\u001b[4;34;4mo\u001b[m\u001b[4;34;4mn\u001b[m\u001b[4;34;4mn\u001b[m\u001b[4;34;4me\u001b[m\u001b[4;34;4mc\u001b[m\u001b[4;34;4mt\u001b[m\u001b[4;34;4mi\u001b[m\u001b[4;34;4mo\u001b[m\u001b[4;34;4mn\u001b[m\u001b[4;34;4mS\u001b[m\u001b[4;34;4mt\u001b[m\u001b[4;34;4mr\u001b[m\u001b[4;34;4ma\u001b[m\u001b[4;34;4mt\u001b[m\u001b[4;34;4me\u001b[m\u001b[4;34;4mg\u001b[m\u001b[4;34;4my\u001b[m\u001b[4;34;4m.\u001b[m\u001b[4;34;4m_\u001b[m\u001b[4;34;4mb\u001b[m\u001b[4;34;4mu\u001b[m\u001b[4;34;4mi\u001b[m\u001b[4;34;4ml\u001b[m\u001b[4;34;4md\u001b[m\u001b[4;34;4mH\u001b[m\u001b[4;34;4ma\u001b[m\u001b[4;34;4mr\u001b[m\u001b[4;34;4mn\u001b[m\u001b[4;34;4me\u001b[m\u001b[4;34;4ms\u001b[m\u001b[4;34;4ms\u001b[m\u001b[4;34;4mC\u001b[m\u001b[4;34;4mo\u001b[m\u001b[4;34;4mn\u001b[m\u001b[4;34;4mf\u001b[m\u001b[4;34;4mi\u001b[m\u001b[4;34;4mg\u001b[m\u001b]8;;\u001b\\ sends this to \u001b[94mlocalharness\u001b[m over the WebSocket initialization\u001b[K\r\n\u001b[?5W\u001b[J\u001b[6Chandshake as:\r\n\t\u001b[38;5;214m\"workspaces\"\u001b[38;5;124;48;5;188m:\u001b[38;5;252;49m [\u001b[m\r\n\t\u001b[38;5;252m  { \u001b[38;5;70;1m\"filesystem_workspace\"\u001b[38;5;252;22m: { \u001b[38;5;70;1m\"directory\"\u001b[38;5;252;22m: \u001b[38;5;214"]
[0.0, "o", "m\"<Directory.current.absolute.path>\"\u001b[38;5;252m } }\u001b[m\r\n\t\u001b[38;5;252m]\u001b[m\r\n\n  3. \u001b[1mSubprocess Spawning (\u001b[94;22mProcess.start\u001b[39;1m)\u001b[m\n\u001b[34D\u2022 \u001b[34;4m\u001b]8;id=jk71ffc046d50b4e69;file:///Users/brett/.pub-cache/hosted/pub.dev/antigravity-0.18.1/lib/src/connections/local/local_connection.dart#L152\u0007LocalConnectionStrategy.start\u001b[m\u001b]8;;\u0007 spawns the binary via \u001b[94mProcess.start(resolvedBinaryPath, [])\u001b[m without a\r\n\u001b[6C\u001b[94mworkingDirectory\u001b[m parameter, so the \u001b[94mlocalharness\u001b[m child process also inherits \u001b[94mDirectory.current\u001b[m from the Flutter\r\n\u001b[6Capp.\r\n\n\n  \u001b[1m#### What directory that resolves to in practice on macOS:\u001b[m\r\n\n  \u2022 \u001b[1mLaunched via CLI (\u001b[94;22mflutter run -d macos\u001b[39;1m)\u001b[m: \u001b[94mDirectory.current.absolute.path\u001b[m is the shell directory where \u001b[94mflutter run\u001b[m\r\n  was invoked (e.g., \u001b[94m/Users/brett/tmp/agy_genui_demo\u001b[m).\r\n  \u2022 \u001b[1mLaunched from Finder / Dock / \u001b[94;22mopen\u001b[39;1m (\u001b[94;22magy_genui_demo.app\u001b[39;1m)\u001b[m: macOS \u001b[94mlaunchd\u001b[m sets the process working directory of GUI"]
[0.0, "o", "\r\n  app bundles to \u001b[94m/\u001b[m (the root directory), unless changed or overridden.\r\n  \u2500\u2500\u2500\u2500\u2500\u2500\r\n  \u001b[1m### Program Review\u001b[m\r\n\n  \u001b[1m#### Strengths\u001b[m\r\n\n  \u2022 \u001b[1mClean Layered Architecture\u001b[m: Clear separation between domain models (\u001b[34;4m\u001b]8;id=jkdcca5166be3df9d5;file:///Users/brett/tmp/agy_genui_demo/lib/domain/models/chat_models.dart\u0007chat_models.dart\u001b[m\u001b]8;;\u0007), data/SDK session\r\n  management (\u001b[34;4m\u001b]8;id=jk67d67b2927f335aa;file:///Users/brett/tmp/agy_genui_demo/lib/data/repositories/chat_repository.dart\u0007chat_repository.dart\u001b[m\u001b]8;;\u0007), state management (\u001b[34;4m\u001b]8;id=jk4455238f1387e765;file:///Users/brett/tmp/agy_genui_demo/lib/ui/features/chat/view_models/chat_view_model.dart\u0007chat_view_model.dart\u001b[m\u001b]8;;\u0007), and UI widgets.\r\n  \u2022 \u001b[1mPer-Thread Stream & Lifecycle Isolation\u001b[m: \u001b[34;4m\u001b]8;id=jk5335e494054c295;file:///Users/brett/tmp/agy_genui_demo/lib/ui/features/chat/view_models/chat_view_model.dart#L143-L229\u0007ChatViewModel.sendMessage\u001b[m\u001b]8;;\u0007 tracks \u001b[94m_activeRequestIds\u001b[m and\r\n  \u001b[94m_replyS"]
