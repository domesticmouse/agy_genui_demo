[0.017, "o", "\u001b[?2026h\u001b[29A\u001b[25C\u001b[34;4m\u001b]8;id=jk29d2ec593f6ecf4b;file:///Users/brett/.pub-cache/hosted/pub.dev/a2ui_agent-0.1.0/lib/src/utils/renderer_state.dart#L59-L65\u0007RendererState\u001b[m\u001b]8;;\u0007\n\n\n\n\u001b[28C\u001b[34;4m\u001b]8;id=jk609b64f3897ae297;file:///Users/brett/tmp/agy_genui_demo/lib/ui/features/chat/views/chat_screen.dart#L70-L136\u0007ChatScreen\u001b[m\u001b]8;;\u0007 and \u001b[34;4m\u001b]8;id=jkd8c25634eb2fad5f;file:///Users/brett/tmp/agy_genui_demo/lib/ui/features/chat/views/widgets/top_toolbar.dart\u0007TopToolbar\u001b[m\u001b]8;;\u0007\n\u001b[57D\u001b[34;4m\u001b]8;id=jkd20fcccedc20b957;file:///Users/brett/.pub-cache/hosted/pub.dev/a2ui_core-0.5.0/lib/src/core/surface_group_model.dart#L107\u0007renderer.model.allSurfaces\u001b[m\u001b]8;;\u0007\n\n\n\n\n\n\n\u001b[30C\u001b[34;4m\u001b]8;id=jkcaf2db2ce2730b16;file:///Users/brett/tmp/agy_genui_demo/lib/ui/features/chat/view_models/chat_view_model.dart#L662-L665\u0007StreamedAnswer\u001b[m\u001b]8;;\u0007\r\n\t\t \u001b[34;4m\u001b]8;id=jkf19d2076ddce7b4c;file:///Users/brett/tmp/agy_genui_demo/lib/ui/features/chat/views/widgets/message_bubble.dart#L186-L195\u0007MessageBubble\u001b[m\u001b]8;;\u0007 displays \u001b[34;4m\u001b]8;id=jk70969"]
