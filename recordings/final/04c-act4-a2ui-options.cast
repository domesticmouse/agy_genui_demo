m \u2502 A pure Dart server (shelf, dart_frog, CLI)\n\u001b[6Z   \u2502 cannot depend on \u001b[94mflutter\u001b[m. It uses\n\u001b[5Z   \u2502 \u001b[94mBasicCatalog.v1_0()\u001b[m from \u001b[94ma2ui_core\u001b[m and\n\u001b[6Z   \u2502 \u001b[94mA2uiGenerator\u001b[m / \u001b[94mA2uiRequestProcessor\u001b[m /\n\u001b[41D \u2502 \u001b[94mRendererState\u001b[m from \u001b[94ma2ui_agent\u001b[m to prompt the\u001b[K\n\u001b[46D \u2502 LLM, heal/validate streaming \u001b[94m<a2ui-json>\u001b[m, and\u001b[K\n\u001b[48D \u2502 forward validated \u001b[94mAgentToRendererMessage\u001b[ms to\n\u001b[63D\u001b[1K \u2502 \u001b[4b\u2502    \u2502    \u2502 clients.\r\n   \u001b[1m4. Custom Non-Flutter Dart Renderer / Headless\u001b[m  \u2502 \u001b[1mYes\u001b[m \u2502 \u001b[3mOp\u001b[m \u2502 \u001b[3mNo\u001b[m \u2502 Implement y\r\n   \u001b[1mTesting\u001b[m \u001b[3m(e.g. JASPR, terminal UI, or unit\u001b[m \u001b[6b\u2502 \u001b[4b\u2502 \u001b[3mti\t\u001b[m   \u2502\r\n   \u001b[3mtests)\u001b[m\u001b[42X\u001b[42C\u2502 \u001b[4b\u2502 \u001b[3mon\u001b[m \u2502    \u2502\n\u001b[18D\u001b[1K \u2502 \u001b[4b\u2502 \u001b[3mal\u001b[m \u2502    \u2502\r\n\u28df  \u001b[90mGenerating.\u001b[94m..\u001b[m\u001b[K\r\n\u001b[90m\u2514 Tip: Press ? to see keyboard shortcuts.\u001b[m\r\n\n\u001b[94m>\u001b[m\u001b[K\r\n\u001b[90m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2