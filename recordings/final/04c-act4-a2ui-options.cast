n\b\b\b \u2502 \u001b[1mY\u001b[m \n\u001b[5D \u2502 \u001b[1me\u001b[m \n\u001b[5D \u2502 \u001b[1ms\u001b[m \n\u001b[5D \u2502 \n\b\b\b \u2502 \n\b\b\b \u2502 \n\b\b\b \u2502 \n\b\b\b \u2502 \u001b[1mY\u001b[m \n\u001b[5D \u2502 \u001b[1me\u001b[m \n\u001b[5D \u2502 \u001b[1ms\u001b[m \n\u001b[5D \u2502 \n\b\b\b \u2502 \n\b\b\b \u2502 \n\b\b\b \u2502 \n\b\b\b \u2502 \n\u001b[49D\u001b[1mting\u001b[m \u001b[3m(e.g. JASPR, ter\u001b[m\u001b[26X\u001b[26C\u2502\n\n\n\n\u001b[52D\u001b[?2026l\u001b[?2026h\u001b[4A\u001b[25C\u001b[3mminal UI, or\u001b[m\r\n\u28fd \n\n\n\u001b[?2026l\u001b[?2026h\u001b[4A\u001b[37C\u001b[3m unit tests)\u001b[m\n\n\n\n\u001b[49D\u001b[?2026l\u001b[?2026h\u001b[25A\u001b[50C\u2502 \u001b[94ma2\u2026\u001b[m \u2502 \u001b[94m\u2026\u001b[m \u2502 \u001b[94m\u2026\u001b[m \u2502 Why\n\u001b[19D\u253c\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u253c\n\u001b[15D\u2502 \u001b[1mYes\u001b[m \u2502 \u001b[1mY\u001b[m \u2502 \u001b[1mY\u001b[m \u2502 The Flutter app both prompts/streams from the\u001b[K\n\u001b[61D\u2502 \u001b[4b\u2502 \u001b[1me\u001b[m \u2502 \u001b[1me\u001b[m \u2502 LLM (\u001b[94ma2ui_agent\u001b[m + \u001b[94mStreamedAnswer\u001b[m) and renders\n\u001b[61D\u2502     \u2502 \u001b[1ms\u001b[m \u2502 \u001b[1ms\u001b[m \u2502 interactive \u001b[94mA2uiSurface\u001b[m widgets (\u001b[94ma2ui_flutter\u001b[m)\n\u001b[62D\u2502     \u2502   \u2502   \u2502 over shared \u001b[94mSurfaceModel\u001b[m state (\u001b[94ma2ui_core\u001b[m).\n\u001b[59D\u2502 \u001b[1mYes\u001b[m \u2502 \u001b[3mN\u001b[m \u2502 \u001b[1mY\u001b[m \u2502 If your backend server already parses LLM output\n\u001b[64D\u2502     \u2502 \u001b[3mo\u001b[m \u2502 \u001b[1me\u001b[m \u2502 and streams pre-parsed A2UI JSON messages\n\u001b[57D\u2502     \u2502   \u2502 \u001b[1ms\u001b[m \u2502 (\u001b[94mcreateSurface\u001b[m, \u001b[94mupdateComponents\u001b[m,\n\u001b[49D\u2502     \u2502   \u2502   \u2502 \u001b[94mupdateDataModel\u001b[m) over WebSockets/SSE/gRPC, the\n\u001b[62D\u2502     \u2502   \u2502   \u2502 Flutter client only needs\n\u001b[41D\u2502     \u2502   \u2502   \u2502 \u001b[94mMessageProcessor<ComponentImplementation>\u001b[m\n\u001b[57D\u2502     \u2502   \u2502   \u2502 (\u001b[94ma2ui_core\u001b[m) and \u001b[94mA2uiSurface\u001b[m (\u001b[94ma2ui_flutter\u001b[m).\n\u001b[59D\u2502 \u001b[1mYes\u001b[m \u2502 \u001b[1mY\u001b[m \u2502 \u001b[3mN\u001b[m \u2502 A pure Dart server (shelf, dart_frog, CLI)\u001b[K\n\u001b[58D\u2502 \u001b[4b\u2502 \u001b[1me\u001b[m \u2502 \u001b[3mo\u001b[m \u2502 cannot depend on \u001b[94mflutter\u001b[m. It uses\u001b[K\n\u001b[49D\u2502 \u001b[4b\u2502 \u001b[1ms\u001b[m \u2502   \u2502 \u001b[94mBasicCatalog.v1_0()\u001b[m from \u001b[94ma2ui_core\u001b[m and\n\u001b[54D\u2502 \u001b[4b\u2502   \u2502   \u2502 \u001b[94mA2uiGenerator\u001b[m / \u001b[94mA2uiRequestProcessor\u001b[m /\u001b[K\n\u001b[54D\u2502 \u001b[4b\u2502   \u2502   \u2502 \u001b[94mRendererState\u001b[m from \u001b[94ma2ui_agent\u001b[m to prompt the LLM,\n\u001b[64D\u2502 \u001b[4b\u2502   \u2502   \u2502 heal/validate streaming \u001b[94m<a2ui-json>\u001b[m, and forward\n\u001b[64D\u2502 \u001b[4b\u2502   \u2502   \u2502 validated \u001b[94mAgentToRendererMessage\u001b[ms to clients.\n\u001b[61D\u2502 \u001b[1mYes\u001b[m \u2502   \u2502   \u2502\n\u001b[15D\u2502     \u2502   \u2502   \u2502\r\n\t\u001b[90ma\u001b[94mting.\u001b[m\n\n\n\u001b[12D\u001b[?2026l\u001b[?2026h\r\u001b[3A\u28fe \n\n\n\u001b[?2026l\u001b[?2026h\r\u001b[3A\u28f7  \u001b[90mGenerati\u001b[94mng...\u001b[m\n\n\n\u001b[14D\u001b[?2026l\u001b[?2026h\r\u001b[3A\u28ef  \u001b[90mGeneratin\u001b[m\n\n\n\u001b[10D\u001b[?2026l\u001b[?2026h\r\u001b[3A\u28df  \u001b[90mGenerating\u001b[m\n\n\n\u001b[11D\u001b[?2026l\u001b[?2026h\r\n\n\n\u001b[?5W\u001b[28A\u001b[51C\u2502 \u001b[94ma2\u2026\u001b[m \u2502 \u001b[94ma\u001b[m\n\u001b[9D\u253c\u2500\u2500\u2500\u2500\u2500\u253c\u2500\n\u001b[8D\u2502 \u001b[1mYes\u001b[m \u2502 \u001b[1mYe\u001b[m\n\u001b[10D\u2502 \u001b[4b\u2502 \u001b[1ms\u001b[m \n\u001b[10D\u2502 \u001b[4b\u2502   \n\u001b[10D\u2502 \u001b[4b\u2502 \n\u001b[8D\u2502 \u001b[1mYes\u001b[m \u2502 \u001b[3mNo\u001b[m\n\u001b[10D\u2502 \u001b[4b\u2502   \n\u001b[10D\u2502 \u001b[4b\u2502 \n\u001b[8D\u2502 \u001b[4b\u2502 \n\u001b[8D\u2502 \u001b[4b\u2502 \n\u001b[8D\u2502 \u001b[4b\u2502 \n\u001b[8D\u2502 \u001b[4b\u2502 \n\u001b[13D \u001b[4b\u2502 \u001b[1mYes\u001b[m \u2502 \u001b[1mYe\u001b[m\r\n   \u001b[3mWeb, iOS, or Flutter clients)\u001b[m\u001b[19X\u001b[19C\u2502 \u001b[4b\u2502 \u001b[1ms\u001b[m \n\u001b[10D\u2502 \u001b[4b\u2502   \n\u001b[10D\u2502 \u001b[4b\u2502 \n\u001b[8D\u2502 \u001b[4b\u2502 \n\u001b[8D\u2502 \u001b[4b\u2502 \n\u001b[8D\u2502 \u001b[4b\u2502 \n\u001b[8D\u2502 \u001b[1mYes\u001b[m \u2502 \u001b[3mOp\u001b[m\n\u001b[17D \u001b[6b\u2502 \u001b[4b\u2502 \u001b[3mti\u001b[m\r\n   \u001b[3mtests)\u001b[m\u001b[42X\u001b[42C\u2502 \u001b[4b\u2502 \u001b[3mon\u001b[m \u2502   \u2502\r\n\u28df  \u001b[90mGenerating.\u001b[94m..\u001b[m\u001b[K\r\n\u001b[90m\u2514 Tip: Press ? to see keyboard shortcuts.\u001b[m\u001b[K\r\n\u001b[90m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[m\r\n\u001b[94m>\u001b[m\u001b[K\r\n\u001b[90m\u2500\u2500