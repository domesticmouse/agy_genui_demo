[0.05, "o", "\u001b[?2026h\r\u001b[29A      \u2022 Wire \u001b]8;id=jk8d1e9ad05e5b7273;file:///Users/brett/tmp/agy_genui_demo/lib/data/repositories/chat_repository.dart#L365-L416\u001b\\\u001b[4;34;4mC\u001b[m\u001b[4;34;4mh\u001b[m\u001b[4;34;4ma\u001b[m\u001b[4;34;4mt\u001b[m\u001b[4;34;4mR\u001b[m\u001b[4;34;4me\u001b[m\u001b[4;34;4mp\u001b[m\u001b[4;34;4mo\u001b[m\u001b[4;34;4ms\u001b[m\u001b[4;34;4mi\u001b[m\u001b[4;34;4mt\u001b[m\u001b[4;34;4mo\u001b[m\u001b[4;34;4mr\u001b[m\u001b[4;34;4my\u001b[m\u001b[4;34;4m.\u001b[m\u001b[4;34;4mb\u001b[m\u001b[4;34;4mu\u001b[m\u001b[4;34;4mi\u001b[m\u001b[4;34;4ml\u001b[m\u001b[4;34;4md\u001b[m\u001b[4;34;4mA\u001b[m\u001b[4;34;4mg\u001b[m\u001b[4;34;4me\u001b[m\u001b[4;34;4mn\u001b[m\u001b[4;34;4mt\u001b[m\u001b[4;34;4mC\u001b[m\u001b[4;34;4mo\u001b[m\u001b[4;34;4mn\u001b[m\u001b[4;34;4mf\u001b[m\u001b[4;34;4mi\u001b[m\u001b[4;34;4mg\u001b[m\u001b]8;;\u001b\\ so every regular text prompt also attaches \u001b[94mrenderer.\u001b[m\u001b[K\r\n\u001b[?5W\u001b[J\u001b[6C\u001b[94mgetRendererDataModel(version: A2uiProtocolVersion.v1_0)\u001b[m when active surfaces have \u001b[94msendDataModel: true\u001b[m, allowing\r\n\u001b[6Cthe user to fill out an A2UI form and type \u001b[3m\"Looks good, submit that\"\u001b[m in the Markdown composer.\r\n\n  \u2500\u2500\u2500\u2500\u2500\u2500\r\n  \u001b[1m### Option 2: Custom Workspace & Developer Catalog (\u001b[94mCatalogImplementation\u001b[39m Extensions)\u001b[m\r\n\n  Right now \u001b[34;4m\u001b]8"]
[0.0, "o", ";id=jka5cca18b961722cf;file:///Users/brett/tmp/agy_genui_demo/lib/data/repositories/chat_repository.dart#L103\u0007ChatRepository.defaultA2uiCatalog\u001b[m\u001b]8;;\u0007 uses the stock \u001b[94mbasicCatalog()\u001b[m. Because \u001b[94ma2ui_flutter\u001b[m's\r\n  \u001b[34;4m\u001b]8;id=jkdbed9f123314d9f9;file:///Users/brett/.pub-cache/hosted/pub.dev/a2ui_flutter-0.1.0/lib/src/component_implementation.dart#L50\u0007ComponentImplementation\u001b[m\u001b]8;;\u0007 lets you pair any JSON Schema with a Flutter widget builder, we can extend the catalog with\r\n  developer-focused components tailored to an Antigravity coding assistant:\r\n\n  \u2022 \u001b[94mCodeDiffCard\u001b[m: Renders a side-by-side or unified diff preview with \u001b[1mApply Patch\u001b[m / \u001b[1mDiscard\u001b[m action buttons that\r\n  trigger an \u001b[94mActionMessage\u001b[m back to the Antigravity agent.\r\n  \u2022 \u001b[94mFileTreeCard\u001b[39;1m / \u001b[94;22mWorkspaceFileCard\u001b[m: Renders clickable file badges (\u001b[94mpath\u001b[m, \u001b[94mlineStart\u001b[m, \u001b[94mlineEnd\u001b[m, \u001b[94msummary\u001b[m) for files in\r\n  the active \u001b[34;4m\u001b]8;id=jkf038f9790f2bb9ac;file:///Users/brett/tmp/agy_g"]
[0.0, "o", "enui_demo/lib/domain/models/chat_models.dart#L21\u0007ChatProject.workingDirectory\u001b[m\u001b]8;;\u0007.\r\n  \u2022 \u001b[94mCommandRunnerCard\u001b[m: Lets the agent propose a shell command with editable flags/arguments (\u001b[94mTextField\u001b[m / \u001b[94mCheckBox\u001b[m\r\n  bound to the surface data model) and a \u001b[1mRun in Workspace\u001b[m button.\r\n  \u2500\u2500\u2500\u2500\u2500\u2500\r\n  \u001b[1m### Option 3: Persistent Split-Pane \"Surface Canvas\" Drawer (Alongside Inline Chat Surfaces)\u001b[m\r\n\n  As noted in \u001b[94ma2ui_agent\u001b[m's \u001b[34;4m\u001b]8;id=jkb7fc31c34ce95434;file:///Users/brett/.pub-cache/hosted/pub.dev/a2ui_agent-0.1.0/lib/src/utils/renderer_state.dart#L59-L65\u0007RendererState\u001b[m\u001b]8;;\u0007, A2UI supports two UX modes over the same \u001b[94mMessageProcessor\u001b[m: \u001b[1minline chat\u001b[m\r\n  \u001b[1mturns\u001b[m and a \u001b[1mpersistent canvas\u001b[m where multi-turn prompts iteratively evolve a single surface.\r\n\n  \u2022 \u001b[1mWhat we can build\u001b[m:\n\u001b[16D\u2022 Add a toggleable right-hand \u001b[1mA2UI Inspector / Canvas pane\u001b[m in\n\u001b[61D[\u001b[94mChatScreen\u001b[m](file:///Users/brett/tmp/agy_genui_demo/lib/ui/features/chat\r\n\n\u28df "]
