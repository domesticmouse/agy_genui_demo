[0.0, "o", "\u001b[?25l\u001b[?5W\u001b[2J\u001b[3J\u001b[30;3H\u001b[?2026h\r\u001b[29A  3. \u001b[1mOutbound Turn\u001b[m: The app wraps that \u001b[94mA2uiRendererAction\u001b[m in an \u001b[94ma2ui_core\u001b[m \u001b]8;id=jkd06aaaeacc97764c;file:///Users/brett/tmp/agy_genui_demo/lib/ui/features/chat/view_models/chat_view_model.dart#L626-L633\u001b\\\u001b[4;34;4mA\u001b[m\u001b[4;34;4mc\u001b[m\u001b[4;34;4mt\u001b[m\u001b[4;34;4mi\u001b[m\u001b[4;34;4mo\u001b[m\u001b[4;34;4mn\u001b[m\u001b[4;34;4mM\u001b[m\u001b[4;34;4me\u001b[m\u001b[4;34;4ms\u001b[m\u001b[4;34;4ms\u001b[m\u001b[4;34;4ma\u001b[m\u001b[4;34;4mg\u001b[m\u001b[4;34;4me\u001b[m\u001b]8;;\u001b\\ (plus \u001b[94mrenderer.\u001b[m\u001b[K\r\n\u001b[?5W\u001b[J  \u001b[94mgetRendererDataModel(version: A2uiProtocolVersion.v1_0)\u001b[m for surfaces with \u001b[94msendDataModel: true\u001b[m) and sends it back to\r\n  the agent.\r\n  \u2500\u2500\u2500\u2500\u2500\u2500\r\n  \u001b[1m## 3. When to Use Each Package\u001b[m\r\n\n   Architecture / Scenario\u001b[25X\u001b[25C\u2502 \u001b[94ma2\u2026\u001b[m \u2502 \u001b[94ma\u2026\u001b[m \u2502 \u001b[94ma\u2026\u001b[m \u2502 Why\r\n  \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\n   \u001b[1m1. Full-Stack / Local Agent Flutter App\u001b[m \u001b[3m(e.g.\u001b[m   \u2502 \u001b[1mYes\u001b[m \u2502 \u001b[1mYe\u001b[m \u2502 \u001b[1mYe\u001b[m \u2502 The Flutter app both prompts/streams from the\r\n   \u001b[94magy_genui_demo\u001b[39;3m)\u001b[m\u001b[33X\u001b[33C\u2502 \u001b[4b\u2502 \u001b[1ms\u001b[m  \u2502 \u001b[1ms\u001b[m  \u2502 LLM (\u001b[94ma2ui_agent\u001b[m + \u001b[94mStreamedAnswer\u001b[m) and renders\n\u001b[63D\u2502 \u001b[4b\u2502    \u2502    \u2502 interactive \u001b[94mA2uiSurface\u001b[m widgets (\u001b[94ma2ui_flutter\u001b[m)\n\u001b[64D\u2502 \u001b[4b\u2502    \u2502    \u2502 over shared \u001b[94mSurfaceModel\u001b[m state (\u001b[94ma2ui_core\u001b[m).\r\n   \u001b[1m2. Thin Flutter Client + Remote Backend Agent\u001b[m   \u2502 \u001b[1mYes\u001b[m \u2502 \u001b[3mNo\u001b[m \u2502 \u001b[1mYe\u001b[m \u2502 If your backend server already parses LLM\n\u001b[59D\u2502 \u001b[4b\u2502    \u2502 \u001b[1ms\u001b[m  \u2502 output and streams pre-parsed A2UI JSON\n\u001b[57D\u2502 \u001b[4b\u2502    \u2502    \u2502 messages (\u001b[94mcreateSurface\u001b[m, \u001b[94mupdateComponents\u001b[m,\n\u001b[60D\u2502 \u001b[4b\u2502    \u2502    \u2502 \u001b[94mupdateDataModel\u001b[m) over WebSockets/SSE/gRPC, the\n\u001b[64D\u2502 \u001b[4b\u2502    \u2502    \u2502 Flutter client only needs\n\u001b[43D\u2502 \u001b[4b\u2502    \u2502    \u2502 \u001b[94mMessageProcessor<ComponentImplementation>\u001b[m\n\u001b[59D\u2502 \u001b[4b\u2502    \u2502    \u2502 (\u001b[94ma2ui_core\u001b[m) and \u001b[94mA2uiSurface\u001b[m (\u001b[94ma2ui_flutter\u001b[m).\r\n   \u001b[1m3. Dart Backend Agent Server / CLI\u001b[m \u001b[3m(serving\u001b[m \u001b[4b\u2502 \u001b[1mYes\u001b[m \u2502 \u001b[1mYe\u001b[m \u2502 \u001b[3mNo\u001b[m \u2502 A pure Dart server (shelf, dart_frog, CLI)\r\n   \u001b[3mWeb, iOS, or Flutter clients)\u001b[m\u001b[19X\u001b[19C\u2502 \u001b[4b\u2502 \u001b[1ms\u001b[m  \u2502    \u2502 cannot depend on \u001b[94mflutter\u001b[m. It uses\n\u001b[51D\u2502 \u001b[4b\u2502    \u2502    \u2502 \u001b[94mBasicCatalog.v1_0()\u001b[m from \u001b[94ma2ui_core\u001b[m and\n\u001b[56D\u2502 \u001b[4b\u2502    \u2502    \u2502 \u001b[94mA2uiGenerator\u001b[m / \u001b[94mA2uiRequestProcessor\u001b[m /\n\u001b[56D\u2502 \u001b[4b\u2502    \u2502    \u2502 \u001b[94mRendererState\u001b[m from \u001b[94ma2ui_agent\u001b[m to prompt the\n\u001b[61D\u2502 \u001b[4b\u2502    \u2502    \u2502 LLM, heal/validate streaming \u001b[94m<a2ui-json>\u001b[m, and\n\u001b[63D\u2502 \u001b[4b\u2502    \u2502    \u2502 forward validated \u001b[94mAgentToRendererMessage\u001b[ms to\n\u001b[62D\u2502 \u001b[4b\u2502    \u2502    \u2502 clients.\r\n\u28df  \u001b[90mG\u001b[94menera\u001b[90mting...\u001b[m\r\n\u001b[90m\u2514 Tip: Press ? to see keyboard shortcuts.\u001b[m\r\n\u001b[90m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[m\r\n\u001b[94m>\u001b[m\r\n\u001b[90m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[m\r\n\u001b[90mesc to cancel\u001b[m\u001b[84X\u001b[84C\u001b[2mGemini 4 Argon \u00b7 medium\u001b[m\r\u001b[2A\u001b[2C\u001b[?2026l\u001b[?2026h\r\n\n\n\u001b[?5W\u001b[27A\u001b[49C\u2502 \u001b[94ma2u\u2026\u001b[m \u2502 \u001b[94ma2\u2026\u001b[m \u2502 \u001b[94ma2\u2026\u001b[m \u2502 Why\n\u001b[24D\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u253c\n\u001b[20D\u2502 \u001b[1mYes\u001b[m  \u2502 \u001b[1mYes\u001b[m \u2502 \u001b[1mYes\u001b[m \u2502 The Flutter app both prompts/streams from the\n\u001b[66D\u2502 \u001b[5b\u2502 \u001b[4b\u2502     \u2502 LLM (\u001b[94ma2ui_agent\u001b[m + \u001b[94mStreamedAnswer\u001b[m) and renders\n\u001b[66D\u2502 \u001b[5b\u2502 \t    \u2502 interactive \u001b[94mA2uiSurface\u001b[m widgets (\u001b[94ma2ui_flutter\u001b[m)\n\u001b[67D\u2502 \u001b[5b\u2502 \t    \u2502 over shared \u001b[94mSurfaceModel\u001b[m state (\u001b[94ma2ui_core\u001b[m).\n\u001b[64D\u2502 \u001b[1mYes\u001b[m  \u2502 \u001b[3mNo\u001b[m  \u2502 \u001b[1mYes\u001b[m \u2502 If your backend server already parses LLM\n\u001b[62D\u2502 \u001b[5b\u2502 \u001b[4b\u2502     \u2502 output and streams pre-parsed A2UI JSON\n\u001b[60D\u2502 \u001b[5b\u2502 \t    \u2502 messages (\u001b[94mcreateSurface\u001b[m, \u001b[94mupdateComponents\u001b[m,\n\u001b[63D\u2502 \u001b[5b\u2502 \t    \u2502 \u001b[94mupdateDataModel\u001b[m) over WebSockets/SSE/gRPC, the\n\u001b[67D\u2502 \u001b[5b\u2502 \t    \u2502 Flutter client only needs\n\u001b[46D\u2502 \u001b[5b\u2502 \t    \u2502 \u001b[94mMessageProcessor<ComponentImplementation>\u001b[m\n\u001b[62D\u2502 \u001b[5b\u2502 \t    \u2502 (\u001b[94ma2ui_core\u001b[m) and \u001b[94mA2uiSurface\u001b[m (\u001b[94ma2ui_flutter\u001b[m).\n\u001b[64D\u2502 \u001b[1mYes\u001b[m  \u2502 \u001b[1mYes\u001b[6C\u001b[m \u2502 A pure Dart server (shelf, dart_frog, CLI)\n\u001b[63D\u2502 \u001b[5b\u2502   \t    \u2502 cannot depend on \u001b[94mflutter\u001b[m. It uses\n\u001b[54D\u2502 \u001b[5b\u2502 \t    \u2502 \u001b[94mBasicCatalog.v1_0()\u001b[m from \u001b[94ma2ui_core\u001b[m and\n\u001b[59D\u2502 \u001b[5b\u2502 \t    \u2502 \u001b[94mA2uiGenerator\u001b[m / \u001b[94mA2uiRequestProcessor\u001b[m /\n\u001b[59D\u2502 \u001b[5b\u2502 \t    \u2502 \u001b[94mRendererState\u001b[m from \u001b[94ma2ui_agent\u001b[m to prompt the\n\u001b[64D\u2502 \u001b[5b\u2502 \t    \u2502 LLM, heal/validate streaming \u001b[94m<a2ui-json>\u001b[m, and\n\u001b[66D\u2502 \u001b[5b\u2502 \t    \u2502 forward validated \u001b[94mAgentToRendererMessage\u001b[ms to\n\u001b[65D\u2502 \u001b[5b\u2502 \t    \u2502 clients.\r\n   \u001b[1m4.\u001b[m\u001b[44X\u001b[44C\u2502 \u001b[5b\u2502 \u001b[4b\u2502 \u001b[4b\u2502\r\n\u28df  \u001b[90mG\u001b[94menera\u001b[90mting...\u001b[m\u001b[K\r\n\u001b[90m\u2514 Tip: Press ? to see keyboard shortcuts.\u001b[m\u001b[K\r\n\u001b[90m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[m\r\n\u001b[94m>\u001b[m\u001b[K\r\n\u001b[90m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[m\r\n\u001b[90mesc to cancel\u001b[m\u001b[84X\u001b[84C\u001b[2mGemini 4 Argon \u00b7 medium\u001b[m\r\u001b[2A\u001b[2C\u001b[?2026l\u001b[?2026h\r\u001b[3A\u287f \n\n\n\u001b[?2026l\u001b[?2026h\r\u001b[3A\u28bf  \u001b[90mGen\u001b[94merati\u001b[m\n\n\n\u001b[9D\u001b[?2026l\u001b[?2026h\r\u001b[3A\u28fb  \u001b[90mGene\u001b[94mratin\u001b[m\n\n\n\u001b[10D\u001b[?2026l\u001b[?2026h\u001b[4A\u001b[3C\u001b[1m Custom Non-\u001b[m\n\n\n\n\u001b[15D\u001b[?2026l\u001b[?2026h\u001b[4A\u001b[15C\u001b[1mFlutter Dart\u001b[m\n\u001b[22D\u001b[90mr\u001b[94mating\u001b[m\n\n\n\u001b[11D\u001b[?2026l\u001b[?2026h\u001b[25A\u001b[47C   \u2502 \u001b[94ma\u2026\u001b[m \u2502 \u001b[94m\u2026\u001b[m \u2502 \u001b[94m\u2026\u001b[m\u001b[3P\n\u001b[15D\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u253c\u2500\u2500\u2500\n\u001b[20D   \u2502 \u001b[1mYe\u001b[m \u2502 \u001b[1mY\u001b[m \u2502 \u001b[1mY\u001b[m \u2502 The Flutter app both prompts/streams from the LLM\n\u001b[67D   \u2502 \u001b[1ms\u001b[m  \u2502 \u001b[1me\u001b[m \u2502 \u001b[1me\u001b[m \u2502 \u001b[7P\n\u001b[18D   \u2502    \u2502 \u001b[1ms\u001b[m \u2502 \u001b[1ms\u001b[C\u001b[m\u001b[3P\n\u001b[16D   \u2502    \u2502   \u2502 \u001b[3P\n\u001b[14D   \u2502 \u001b[1mYe\u001b[m \u2502 \u001b[3mN\u001